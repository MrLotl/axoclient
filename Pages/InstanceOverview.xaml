<UserControl x:Class="McLauncher.Pages.InstanceOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel Margin="0,0,12,0">
            <ItemsControl x:Name="StatsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="20" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedText}"
                                           FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Arbeitsspeicher" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12">
                <DockPanel>
                    <Button x:Name="RamButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                            Background="{StaticResource Accent}" Content="Empfehlung übernehmen" Padding="12,6"
                            Margin="12,0,0,0" Click="Ram_Click"/>
                    <TextBlock x:Name="RamText" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <TextBlock Text="Abstürze" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}" Content="Analysieren"
                            Padding="12,6" Margin="12,0,0,0" Click="Crash_Click"/>
                    <TextBlock x:Name="CrashText" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <TextBlock Text="Overlay-Profile" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="ProfilesText" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <ItemsControl x:Name="ProfileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30"
                                            Height="30" FontSize="12" Content="&#xE74D;" Margin="6,0,0,0"
                                            ToolTip="Profil löschen" Click="DeleteProfile_Click"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                                            Content="Teilen" Padding="12,6" Click="ShareProfile_Click"
                                            ToolTip="An Freunde senden oder als Datei speichern"/>
                                    <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
