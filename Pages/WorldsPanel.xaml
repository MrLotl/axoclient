<UserControl x:Class="McLauncher.Pages.WorldsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Panel_Drop" DragOver="Panel_DragOver">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource LauncherButton}" Margin="0,0,8,0" Click="Import_Click"
                        ToolTip="Welt aus ZIP-Datei importieren (oder ZIP/Ordner hierher ziehen)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Importieren"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE777;" Margin="0,0,8,0"
                        ToolTip="Backup-Ordner öffnen" Click="OpenBackups_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="0"
                        ToolTip="saves-Ordner öffnen" Click="OpenSaves_Click"/>
            </StackPanel>
            <TextBlock x:Name="Header" Text="Welten" Foreground="White" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="Noch keine Welten. Starte das Spiel und erstelle eine, importiere eine ZIP-Datei oder übertrage Welten im Tab &quot;Übertragen&quot;."/>

        <ListBox x:Name="WorldList" Style="{StaticResource CardList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="6" Background="#22FFFFFF"
                                Margin="0,0,12,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xE909;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Backup als ZIP erstellen"
                                    Margin="0,0,6,0" Click="Backup_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Ordner öffnen"
                                    Margin="0,0,6,0" Click="OpenWorld_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    ToolTip="In den Papierkorb verschieben" Margin="0,0,10,0" Click="Delete_Click"/>
                            <Button Style="{StaticResource LauncherButton}" Background="{StaticResource Accent}"
                                    Content="Spielen" Click="Play_Click"
                                    ToolTip="Direkt in diese Welt starten (ab Minecraft 1.20)"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
