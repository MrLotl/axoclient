<UserControl x:Class="McLauncher.Pages.SkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:McLauncher.Pages">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Skins" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
            <TextBlock x:Name="LoginHint" DockPanel.Dock="Top" Foreground="{StaticResource SubtleText}"
                       Text="Melde dich links unten an, um Skins und Umhänge zu ändern." Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Links: aktueller Skin -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Aktueller Skin" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10">
                        <pages:SkinViewer x:Name="CurrentSkin" Height="320"/>
                    </Border>
                    <TextBlock x:Name="CurrentVariant" Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,8,0,10"/>
                    <Button x:Name="SaveCurrentButton" Style="{StaticResource LauncherButton}"
                            Content="In Bibliothek speichern" Click="SaveCurrent_Click"/>
                </StackPanel>

                <!-- Rechts: hinzufügen, Bibliothek, Umhang -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Neuen Skin hinzufügen" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="DropZone" AllowDrop="True" Cursor="Hand" CornerRadius="10" Padding="16"
                                Background="#0DFFFFFF" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                                MouseLeftButtonUp="DropZone_Click" BorderBrush="#44FFFFFF" BorderThickness="1.5">
                            <DockPanel>
                                <Image x:Name="NewSkinPreview" DockPanel.Dock="Left" Width="48" Height="96"
                                       Margin="0,0,16,0" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Visibility="Collapsed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DropText" Foreground="White" FontWeight="SemiBold"
                                               Text="Skin-Datei (PNG) hierher ziehen oder klicken"/>
                                    <TextBlock Foreground="{StaticResource MutedText}" FontSize="11"
                                               Text="64×64 Pixel, z.B. von namemc.com oder minecraftskins.com"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <StackPanel x:Name="NewSkinOptions" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NewSkinName" Style="{StaticResource LauncherTextBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="Modell" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="ClassicRadio" Style="{StaticResource SegmentButton}"
                                             GroupName="SkinVariant" Content="Breite Arme (Steve)" IsChecked="True"
                                             Checked="Variant_Checked"/>
                                <RadioButton x:Name="SlimRadio" Style="{StaticResource SegmentButton}"
                                             GroupName="SkinVariant" Content="Schmale Arme (Alex)"
                                             Checked="Variant_Checked"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ApplyNewButton" Style="{StaticResource LauncherButton}"
                                        Background="{StaticResource Accent}" Content="Anwenden &amp; speichern"
                                        Margin="0,0,8,0" Click="ApplyNew_Click"/>
                                <Button Style="{StaticResource LauncherButton}" Content="Nur speichern"
                                        Margin="0,0,8,0" Click="SaveNew_Click"/>
                                <Button Style="{StaticResource LauncherButton}" Content="Verwerfen"
                                        Click="DiscardNew_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Meine Skins" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                        <TextBlock x:Name="LibraryEmpty" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Noch keine Skins gespeichert. Füge oben einen hinzu oder speichere deinen aktuellen Skin."/>
                        <ItemsControl x:Name="LibraryList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="140" Background="#14FFFFFF" CornerRadius="8" Padding="10"
                                            Margin="0,0,10,10">
                                        <StackPanel>
                                            <Image Source="{Binding Preview}" Width="48" Height="96" Margin="0,4,0,8"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding VariantText}" Foreground="{StaticResource MutedText}"
                                                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                        Width="30" Height="30" FontSize="12" Content="&#xE74D;"
                                                        ToolTip="Aus Bibliothek entfernen" Click="RemoveSkin_Click"/>
                                                <Button Style="{StaticResource LauncherButton}"
                                                        Background="{StaticResource Accent}" Padding="6,6"
                                                        Content="Anwenden" Click="ApplySkin_Click"
                                                        IsEnabled="{Binding DataContext.CanApply, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Minecraft-Umhänge" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                        <TextBlock x:Name="CapesEmpty" Foreground="{StaticResource MutedText}"
                                   Text="Dein Konto besitzt keine Umhänge." Visibility="Collapsed"/>
                        <WrapPanel x:Name="CapePanel"/>

                        <TextBlock Text="AxoClient-Umhänge" Style="{StaticResource SectionTitle}" Margin="0,24,0,4"/>
                        <TextBlock x:Name="ClientCapesHint" Foreground="{StaticResource MutedText}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Sehen alle, die AxoClient nutzen (Fabric-Instanzen mit unterstützter Minecraft-Version). Ein AxoClient-Umhang wird dort statt deines Minecraft-Umhangs angezeigt."/>
                        <WrapPanel x:Name="ClientCapePanel"/>

                        <TextBlock x:Name="StatusText" Foreground="{StaticResource SubtleText}" Margin="0,16,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
