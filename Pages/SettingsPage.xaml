<UserControl x:Class="McLauncher.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Einstellungen" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,12,0">

                    <!-- Java & Leistung -->
                    <TextBlock Text="Java &amp; Leistung" Style="{StaticResource SectionTitle}"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="RamValue" DockPanel.Dock="Right" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="Maximaler Arbeitsspeicher" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </DockPanel>
                    <Slider x:Name="RamSlider" Minimum="1024" TickFrequency="512" IsSnapToTickEnabled="True"
                            ValueChanged="RamSlider_ValueChanged"/>
                    <TextBlock x:Name="RamHint" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,16"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Zusätzliche Java-Argumente" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="JvmArgsBox" Style="{StaticResource LauncherTextBox}" LostFocus="Text_LostFocus"/>
                    <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,22" TextWrapping="Wrap"
                               Text="Für Fortgeschrittene, z.B. -XX:+UseG1GC. Leer lassen, wenn du unsicher bist."/>

                    <!-- Spielfenster -->
                    <TextBlock Text="Spielfenster" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="FullScreenCheck" Content="Im Vollbild starten" Margin="0,0,0,12"
                              Click="Check_Click"/>
                    <TextBlock Text="Fenstergröße (leer = Standard)" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <TextBox x:Name="WidthBox" Style="{StaticResource LauncherTextBox}" Width="100"
                                 LostFocus="Text_LostFocus" PreviewTextInput="Number_PreviewTextInput"/>
                        <TextBlock Text="×" Foreground="{StaticResource SubtleText}" VerticalAlignment="Center"
                                   Margin="10,0"/>
                        <TextBox x:Name="HeightBox" Style="{StaticResource LauncherTextBox}" Width="100"
                                 LostFocus="Text_LostFocus" PreviewTextInput="Number_PreviewTextInput"/>
                    </StackPanel>

                    <!-- Launcher -->
                    <TextBlock Text="Launcher" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="MinimizeCheck" Content="Launcher nach dem Spielstart minimieren"
                              Margin="0,0,0,16" Click="Check_Click"/>

                    <TextBlock Text="CurseForge-API-Schlüssel" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CurseForgeKeyBox" Style="{StaticResource LauncherTextBox}" LostFocus="Text_LostFocus"/>
                    <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,16" TextWrapping="Wrap">
                        Wird für die CurseForge-Suche benötigt. Kostenlos unter
                        <Hyperlink NavigateUri="https://console.curseforge.com/" RequestNavigate="Link_RequestNavigate"
                                   Foreground="#6FCF97">console.curseforge.com</Hyperlink>.
                    </TextBlock>

                    <!-- Discord-Status -->
                    <TextBlock Text="Discord-Status" Style="{StaticResource SectionTitle}" Margin="0,6,0,10"/>
                    <TextBlock Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                               Text="Zeigt in Discord „Spielt AxoClient“ mit Axolotl-Bild, Instanz und Spielzeit, solange ein Spiel läuft (der Launcher muss dafür geöffnet bleiben, minimiert reicht)."/>
                    <CheckBox x:Name="DiscordCheck" Content="Discord-Status anzeigen" Margin="0,0,0,12" Click="Check_Click"/>
                    <TextBlock Text="Application-ID der Discord-Anwendung „AxoClient“" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DiscordAppIdBox" Style="{StaticResource LauncherTextBox}" LostFocus="Text_LostFocus"
                             PreviewTextInput="Number_PreviewTextInput"/>
                    <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,22" TextWrapping="Wrap"
                               Text="Aus dem Discord Developer Portal – die Einrichtung steht in discord/ANLEITUNG.md."/>

                    <!-- Axolotl-Symbol in der Tabliste -->
                    <TextBlock Text="Axolotl-Symbol in der Tabliste" Style="{StaticResource SectionTitle}" Margin="0,6,0,10"/>
                    <DockPanel Margin="0,0,0,12">
                        <Image DockPanel.Dock="Left" Source="Assets/axolotl.png" Width="32" Height="32" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                        <TextBlock Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" FontSize="12"
                                   Text="Spieler, die diesen Launcher nutzen, bekommen in der Tabliste ein kleines Axolotl oben rechts am Kopf. Funktioniert in Fabric-Instanzen mit Minecraft 26.2 auf Servern, die Spielerköpfe anzeigen."/>
                    </DockPanel>
                    <CheckBox x:Name="BadgeCheck" Content="Symbol anzeigen und mich als Launcher-Nutzer anmelden"
                              Margin="0,0,0,12" Click="Check_Click"/>
                    <TextBlock Text="Adresse des Symbol-Dienstes (Cloudflare Worker)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button x:Name="BadgeTestButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                                Content="Verbindung testen" Margin="8,0,0,0" Click="BadgeTest_Click"/>
                        <TextBox x:Name="BadgeUrlBox" Style="{StaticResource LauncherTextBox}" LostFocus="Text_LostFocus"/>
                    </DockPanel>
                    <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,22" TextWrapping="Wrap"
                               Text="z.B. https://mclauncher-badge.deinname.workers.dev – die Einrichtung steht in service/ANLEITUNG.md."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Button Style="{StaticResource LauncherButton}" Click="OpenLauncherFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Launcher-Ordner öffnen"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="SavedText" Foreground="{StaticResource MutedText}" FontSize="11"
                               Text="Änderungen werden automatisch gespeichert."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
