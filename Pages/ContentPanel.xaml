<UserControl x:Class="McLauncher.Pages.ContentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Liste: Bild, Name, Version, rechts Aktionen -->
        <DataTemplate x:Key="ListTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" Background="#22FFFFFF"
                        Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                          VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Aktiviert"
                          Click="ToggleInstalled_Click"
                          Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Background="{StaticResource Accent}" Content="&#xE896;" Margin="4,0,0,0"
                            ToolTip="{Binding UpdateText}" Click="UpdateOne_Click"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="&#xE81C;" Margin="4,0,0,0" Click="ChangeVersion_Click"
                            IsEnabled="{Binding CanChangeVersion}">
                        <Button.ToolTip>
                            <ToolTip Content="Version ändern (bei manuell hinzugefügten Dateien nach 'Updates suchen' möglich)"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="&#xE74D;" Margin="4,0,0,0" ToolTip="Löschen" Click="DeleteInstalled_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedText}"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding UpdateText}" Foreground="#6FCF97" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Kacheln: großes Bild, Name, Version, darunter Aktionen -->
        <DataTemplate x:Key="TileTemplate">
            <StackPanel Width="150">
                <Border Width="150" Height="150" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="40"
                                       Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="2,8,2,0"/>
                <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedText}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="2,0,2,0"/>
                <TextBlock Text="{Binding UpdateText}" Foreground="#6FCF97" FontSize="11" TextTrimming="CharacterEllipsis"
                           Margin="2,0,2,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                <DockPanel Margin="0,8,0,0">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              ToolTip="Aktiviert" IsChecked="{Binding Enabled, Mode=OneWay}" Click="ToggleInstalled_Click"
                              Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Background="{StaticResource Accent}" Content="&#xE896;" Margin="0,0,4,0"
                            ToolTip="{Binding UpdateText}" Click="UpdateOne_Click"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="&#xE81C;" Margin="0,0,4,0" ToolTip="Version ändern" Click="ChangeVersion_Click"
                            IsEnabled="{Binding CanChangeVersion}"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="&#xE74D;" ToolTip="Löschen" Click="DeleteInstalled_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListCol" Width="*"/>
            <ColumnDefinition x:Name="GapCol" Width="0"/>
            <ColumnDefinition x:Name="RightCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Hinweise (z.B. Vanilla ohne Mods, Shader brauchen Iris/Oculus) -->
<Border x:Name="HintPanel" Grid.Row="0" Grid.ColumnSpan="3" Background="#223BA55C" BorderBrush="#553BA55C"
        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
    <DockPanel>
        <Button x:Name="HintButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                Background="{StaticResource Accent}" Margin="10,0,0,0" VerticalAlignment="Center"
                Click="HintButton_Click"/>
        <TextBlock x:Name="HintText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
</Border>


        <!-- ================= Links: installierte Inhalte ================= -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="ViewToggles" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <RadioButton x:Name="ListViewToggle" Style="{StaticResource SegmentButton}" GroupName="ContentView"
                                     Padding="8,6" ToolTip="Liste" Checked="ViewToggle_Checked">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </RadioButton>
                        <RadioButton x:Name="TileViewToggle" Style="{StaticResource SegmentButton}" GroupName="ContentView"
                                     Padding="8,6" ToolTip="Kacheln" Checked="ViewToggle_Checked">
                            <TextBlock Text="&#xECA5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </RadioButton>
                    </StackPanel>
                    <Button x:Name="AddButton" Style="{StaticResource LauncherButton}" Background="{StaticResource Accent}"
                            Content="+ Hinzufügen" Padding="12,0" Margin="0,0,6,0" Click="AddButton_Click"/>
                    <Button x:Name="UpdatesButton" Style="{StaticResource IconButton}" Content="&#xE895;"
                            ToolTip="Nach Updates suchen" Click="CheckUpdates_Click"/>
                    <Button x:Name="RepairButton" Style="{StaticResource IconButton}" Content="&#xE90F;"
                            ToolTip="Mods reparieren: prüfen, ob alle Mods zusammenpassen" Click="Repair_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;"
                            ToolTip="Ordner öffnen" Click="OpenFolder_Click"/>
                </StackPanel>
                <Button x:Name="DoneButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;"
                        Margin="0,0,10,0" ToolTip="Zurück zur Liste" Visibility="Collapsed" Click="Done_Click"/>
                <TextBlock x:Name="InstalledHeader" Text="Installiert" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Hinweis, wenn Updates gefunden wurden -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#223BA55C" BorderBrush="#553BA55C"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,10" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="UpdateAllButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                            Background="{StaticResource Accent}" Padding="10,6" Content="Alle aktualisieren"
                            Click="UpdateAll_Click"/>
                    <TextBlock x:Name="UpdateBannerText" Foreground="White" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <TextBlock x:Name="InstalledEmpty" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap" Text="Noch nichts installiert." Visibility="Collapsed"/>
            <ListBox x:Name="InstalledList" Style="{StaticResource CardList}"/>
        </DockPanel>

        <!-- ================= Rechts ================= -->
        <Grid x:Name="RightPane" Grid.Row="1" Grid.Column="2" Visibility="Collapsed">

            <!-- Ansicht 1: Suche -->
            <DockPanel x:Name="SearchView">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                        <RadioButton x:Name="ModrinthSource" Style="{StaticResource SegmentButton}"
                                     GroupName="Source" Content="Modrinth" Checked="Source_Checked"/>
                        <RadioButton x:Name="CurseForgeSource" Style="{StaticResource SegmentButton}"
                                     GroupName="Source" Content="CurseForge" Checked="Source_Checked"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE721;" ToolTip="Suchen" Click="Search_Click"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource LauncherTextBox}" KeyDown="SearchBox_KeyDown"/>
                </DockPanel>

                <!-- CurseForge-Schlüssel -->
                <Border x:Name="ApiKeyPanel" DockPanel.Dock="Top" Background="#14FFFFFF" CornerRadius="8"
                        Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource SubtleText}" TextWrapping="Wrap">
                            Für CurseForge wird ein kostenloser API-Schlüssel benötigt. Du bekommst ihn unter
                            <Hyperlink NavigateUri="https://console.curseforge.com/" RequestNavigate="Link_RequestNavigate"
                                       Foreground="#6FCF97">console.curseforge.com</Hyperlink>
                            (Anmelden → API Keys). Du kannst ihn auch später unter Einstellungen ändern.
                        </TextBlock>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                                    Background="{StaticResource Accent}" Content="Speichern" Margin="8,0,0,0"
                                    Click="SaveApiKey_Click"/>
                            <TextBox x:Name="ApiKeyBox" Style="{StaticResource LauncherTextBox}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ResultsEmpty" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Seitennavigation -->
                <DockPanel x:Name="Pager" DockPanel.Dock="Bottom" Margin="0,10,8,0" Visibility="Collapsed">
                    <Button x:Name="PrevPage" DockPanel.Dock="Left" Style="{StaticResource LauncherButton}"
                            Click="PrevPage_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Zurück"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextPage" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                            Click="NextPage_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Weiter"/>
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="PageText" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalText" Foreground="{StaticResource MutedText}" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="ResultsList" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="6"
                                        Background="#22FFFFFF" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Width="140">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30"
                                                Height="32" FontSize="11" Margin="4,0,0,0" Content="&#xE70D;"
                                                ToolTip="Version auswählen" Click="ChooseVersion_Click"/>
                                        <Button Style="{StaticResource LauncherButton}" Background="{StaticResource Accent}"
                                                Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}"
                                                Height="32" Padding="8,0" Click="Install_Click"/>
                                    </DockPanel>
                                    <Button Style="{StaticResource LauncherButton}" Content="Webseite"
                                            Margin="0,6,0,0" Padding="8,4" FontSize="11" Click="Website_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Foreground="White" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                        <Run Text="{Binding Author, Mode=OneWay, StringFormat=von {0}}"
                                             Foreground="{StaticResource MutedText}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleText}"
                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding DownloadsText}" Foreground="{StaticResource MutedText}"
                                               FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Ansicht 2: Version auswählen -->
            <DockPanel x:Name="VersionsView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="0,0,12,0"
                            ToolTip="Zurück" Click="BackToSearch_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionsTitle" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="VersionsSubtitle" Foreground="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="VersionsEmpty" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <ListBox x:Name="VersionsList" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                                        Background="{StaticResource Accent}" Width="110" VerticalAlignment="Center"
                                        Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}"
                                        Click="InstallVersion_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="White" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Version.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Badge, Mode=OneWay}" Foreground="#6FCF97"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Version.Details}" Foreground="{StaticResource MutedText}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Ansicht 3: Mods reparieren -->
            <DockPanel x:Name="RepairView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="0,0,12,0"
                            ToolTip="Zurück" Click="BackToSearch_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mods reparieren" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RepairSubtitle" Foreground="{StaticResource MutedText}" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,8,0">
                    <Button x:Name="FixButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                            Background="{StaticResource Accent}" Content="Ausgewählte beheben" Click="Fix_Click"/>
                    <Button x:Name="RecheckButton" DockPanel.Dock="Left" Style="{StaticResource LauncherButton}"
                            Content="Erneut prüfen" Click="Repair_Click"/>
                    <Grid/>
                </DockPanel>
                <ListBox x:Name="IssueList" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                           FontSize="18" Margin="0,2,12,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6FA8DC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="#E36D6F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#E8B84A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleText}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <CheckBox Content="{Binding FixText}" IsChecked="{Binding Selected}" Margin="0,8,0,0"
                                              Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="{StaticResource SubtleText}"
                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
