<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AxoClient</AssemblyName>
    <RootNamespace>AxoClient.App</RootNamespace>
    <ApplicationIcon>Assets\axoclient.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UiDir>$(MSBuildProjectDirectory)\..\..\ui</UiDir>
  </PropertyGroup>

  <!-- Veröffentlichung als eine einzige EXE (= AxoClient-Setup.exe): dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxoClient.Common\AxoClient.Common.csproj" />
    <ProjectReference Include="..\AxoClient.DataModel\AxoClient.DataModel.csproj" />
    <ProjectReference Include="..\AxoClient.Accounts.Contract\AxoClient.Accounts.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Accounts\AxoClient.Accounts.csproj" />
    <ProjectReference Include="..\AxoClient.Settings.Contract\AxoClient.Settings.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Settings\AxoClient.Settings.csproj" />
    <ProjectReference Include="..\AxoClient.Game.Contract\AxoClient.Game.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Game\AxoClient.Game.csproj" />
    <ProjectReference Include="..\AxoClient.Instances.Contract\AxoClient.Instances.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Instances\AxoClient.Instances.csproj" />
    <ProjectReference Include="..\AxoClient.Content.Contract\AxoClient.Content.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Content\AxoClient.Content.csproj" />
    <ProjectReference Include="..\AxoClient.Import.Contract\AxoClient.Import.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Import\AxoClient.Import.csproj" />
    <ProjectReference Include="..\AxoClient.Launch.Contract\AxoClient.Launch.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Launch\AxoClient.Launch.csproj" />
    <ProjectReference Include="..\AxoClient.Servers.Contract\AxoClient.Servers.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Servers\AxoClient.Servers.csproj" />
    <ProjectReference Include="..\AxoClient.Skins.Contract\AxoClient.Skins.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Skins\AxoClient.Skins.csproj" />
    <ProjectReference Include="..\AxoClient.Social.Contract\AxoClient.Social.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Social\AxoClient.Social.csproj" />
    <ProjectReference Include="..\AxoClient.Integrations.Contract\AxoClient.Integrations.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Integrations\AxoClient.Integrations.csproj" />
    <ProjectReference Include="..\AxoClient.Diagnostics.Contract\AxoClient.Diagnostics.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Diagnostics\AxoClient.Diagnostics.csproj" />
    <ProjectReference Include="..\AxoClient.Updates.Contract\AxoClient.Updates.Contract.csproj" />
    <ProjectReference Include="..\AxoClient.Updates\AxoClient.Updates.csproj" />
  </ItemGroup>

  <!-- Die Svelte-Oberfläche wird von Vite nach wwwroot gebaut und als Ressource eingebettet.
       So liefert das Fenster nur mitgelieferte Dateien aus (Sicherheit: keine fremden Seiten).
       Inkrementell: Vite läuft nur, wenn sich etwas unter ui/ geändert hat. -->
  <ItemGroup>
    <UiSource Include="$(UiDir)\src\**\*;$(UiDir)\public\**\*;$(UiDir)\index.html;$(UiDir)\package.json;$(UiDir)\vite.config.ts" />
    <!-- Damit Visual Studio/Rider den Build nicht als "aktuell" überspringen, wenn sich nur die Oberfläche geändert hat -->
    <UpToDateCheckInput Include="@(UiSource)" />
    <UpToDateCheckInput Include="wwwroot\**\*" />
  </ItemGroup>

  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Condition="'$(SkipUi)' != 'true'" Inputs="@(UiSource)" Outputs="wwwroot\index.html">
    <Exec Command="npm ci" WorkingDirectory="$(UiDir)" Condition="!Exists('$(UiDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
    <!-- Vite schreibt index.html evtl. mit gleichem Inhalt; Zeitstempel setzen, damit Inputs/Outputs stimmen -->
    <Touch Files="wwwroot\index.html" />
  </Target>

  <Target Name="EmbedUi" BeforeTargets="PrepareForBuild" AfterTargets="BuildUi">
    <ItemGroup>
      <_UiFile Include="wwwroot\**\*" />
      <EmbeddedResource Include="@(_UiFile)" LogicalName="$([System.String]::Copy('wwwroot/%(_UiFile.RecursiveDir)%(_UiFile.Filename)%(_UiFile.Extension)').Replace('\', '/'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Eingebettet statt daneben kopiert: die veröffentlichte AxoClient.exe ist eine einzige Datei -->
    <EmbeddedResource Include="Assets\axoclient.ico" LogicalName="axoclient.ico" />
  </ItemGroup>

</Project>
