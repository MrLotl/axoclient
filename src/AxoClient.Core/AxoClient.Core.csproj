<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AxoClient.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ressourcennamen immer mit "/" (RecursiveDir liefert unter Windows "\", z. B. "axomod\…") -->
    <EmbeddedResource Include="Resources\**\*"
                      LogicalName="$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))" />
    <!-- Animationen der eingebauten Emotes, direkt aus der Mod (eine Quelle): für die Vorschaubilder im Launcher -->
    <EmbeddedResource Include="..\..\mod\src\emote26\resources\assets\axoclient\player_animations\emotes.json"
                      LogicalName="emotes/builtin.json" Link="Resources\emotes\builtin.json" />
    <InternalsVisibleTo Include="AxoClient.Tests" />
  </ItemGroup>

</Project>
