<Window x:Class="McLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:McLauncher.Pages"
        Title="AxoClient" Icon="Assets/axoclient.ico" Height="700" Width="1180" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#1E1F22"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
    <!-- Eigene Titelleiste: Windows zeichnet keine weiße Leiste mehr, Ziehen/Snap/Größe ändern bleiben erhalten -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B20F1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Hintergrund: unscharfes Bild, leicht abgedunkelt. Negativer Rand verhindert helle Blur-Kanten -->
        <Grid ClipToBounds="True">
            <Image Source="Assets/background.jpg" Stretch="UniformToFill" Margin="-40">
                <Image.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            <Rectangle Fill="#66000000"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste -->
            <Border Grid.Column="0" Background="#D91A1B1E" Padding="14,0,14,20">
                <DockPanel>
                    <!-- Logo sitzt in der Titelleiste (Bereich zum Ziehen des Fensters) -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="8,4,0,16">
                        <Image Source="Assets/axolotl.png" Width="34" Height="28" Margin="-4,0,6,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AxoClient" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Version ganz unten -->
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedText}"
                               FontSize="11" Margin="4,8,0,0" Cursor="Hand" ToolTip="Klicken: nach Updates suchen"
                               MouseLeftButtonUp="VersionText_Click"/>

                    <!-- Konto unten -->
                    <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="10" Padding="10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" ClipToBounds="True"
                                    Background="#22FFFFFF" Margin="0,0,10,0">
                                <Image x:Name="AvatarImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" Text="Nicht angemeldet" Foreground="White"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="#6FCF97" FontSize="11" Cursor="Hand">
                                    <Hyperlink x:Name="AccountLink" Foreground="#6FCF97" TextDecorations="{x:Null}"
                                               Click="AccountLink_Click">
                                        <Run x:Name="AccountLinkText" Text="Mit Microsoft anmelden"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;"
                                     Content="Home" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavInstances" Style="{StaticResource NavButton}" Tag="&#xE8F1;"
                                     Content="Instanzen" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSkins" Style="{StaticResource NavButton}" Tag="&#xE77B;"
                                     Content="Skins" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                     Content="Einstellungen" Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Seiten -->
            <Grid Grid.Column="1" Margin="24,44,24,24">
                <pages:HomePage x:Name="HomePage"/>
                <pages:InstancesPage x:Name="InstancesPage" Visibility="Collapsed"/>
                <pages:SkinsPage x:Name="SkinsPage" Visibility="Collapsed"/>
                <pages:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Eingeblendeter Dialog (Bestätigungen, Fehler) statt eigener Fenster -->
        <Grid x:Name="DialogOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Background="#FF2B2D31" CornerRadius="12" Padding="24" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ContentControl x:Name="DialogContent" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="DialogTextScroller" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                        </ScrollViewer.Resources>
                        <TextBox x:Name="DialogText" Foreground="{StaticResource SubtleText}" Background="Transparent"
                                 BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <!-- Fortschrittsanzeige (nur bei RunWithProgressAsync) -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <ProgressBar x:Name="DialogProgress" Height="6" Maximum="100" IsIndeterminate="True"
                                     Background="#552B2D31" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                        <TextBlock x:Name="DialogProgressText" Foreground="{StaticResource SubtleText}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource LauncherButton}" Content="Abbrechen"
                                Margin="0,0,8,0" Click="DialogCancel_Click"/>
                        <Button x:Name="DialogOk" Style="{StaticResource LauncherButton}"
                                Background="{StaticResource Accent}" Content="OK" Click="DialogOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fenster-Buttons oben rechts (nach dem Dialog, damit sie auch dann erreichbar bleiben) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimieren"
                    Click="Minimize_Click"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                    ToolTip="Maximieren" Click="Maximize_Click"/>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Schließen"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
