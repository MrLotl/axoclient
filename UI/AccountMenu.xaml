<UserControl x:Class="AxoClient.UI.AccountMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             FontFamily="{StaticResource UiFont}">
    <Border Width="270" Padding="6" CornerRadius="12" Background="{StaticResource PopupBg}"
            BorderBrush="{StaticResource PopupLine}" BorderThickness="1" Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <TextBlock Text="ACCOUNTS" Style="{StaticResource OverLabel}" Margin="10,8,10,6"/>
            <ItemsControl x:Name="AccountList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource MenuItemButton}" Height="46" Padding="8,0" Margin="0,0,0,2"
                                Click="Account_Click">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" ClipToBounds="True"
                                        Background="#3A3A3A" Margin="0,0,10,0">
                                    <Image Source="{Binding Head}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <Border DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10"
                                        Background="{StaticResource Accent}"
                                        Visibility="{Binding Active, Converter={StaticResource BoolToVisibility}}">
                                    <c:Icon Kind="Check" Size="11" Foreground="White" HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Microsoft-Konto" FontSize="11.5" Foreground="{StaticResource MutedText}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ProblemText" Style="{StaticResource Caption}" Foreground="{StaticResource DangerText}"
                       Margin="10,4,10,6" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="Problem_Click"/>
            <Border Height="1" Margin="6,4" Background="#3A3A3A"/>
            <Button x:Name="AddButton" Style="{StaticResource MenuItemButton}" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="UserAdd" Size="16" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
                    <TextBlock Text="Account hinzufügen" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="LogoutButton" Style="{StaticResource MenuDangerButton}" Click="Logout_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="Logout" Size="16" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LogoutText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
