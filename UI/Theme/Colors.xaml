<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="WindowBg" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ContentBg" Color="#222222"/>
    <SolidColorBrush x:Key="CardBg" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="CardHover" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="RowBg" Color="#323232"/>
    <SolidColorBrush x:Key="RowBgSoft" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="InsetBg" Color="#262626"/>
    <SolidColorBrush x:Key="DeepBg" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PopupBg" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="PopupLine" Color="#363636"/>
    <SolidColorBrush x:Key="MenuHover" Color="#383838"/>
    <SolidColorBrush x:Key="Divider" Color="#333333"/>
    <SolidColorBrush x:Key="DividerSoft" Color="#2F2F2F"/>
    <SolidColorBrush x:Key="ChipBg" Color="#333333"/>

    <SolidColorBrush x:Key="FieldBackground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="FieldFocus" Color="#BFE07AD8"/>

    <SolidColorBrush x:Key="TextStrong" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="SubtleText" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="MutedText" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="LabelText" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="DimText" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="AccentText" Color="#ECC6F2"/>
    <SolidColorBrush x:Key="AccentTextBright" Color="#F5D0FB"/>

    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DB2777" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DB2777" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBright" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EC4899" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#29EC4899" Offset="0"/>
        <GradientStop Color="#298B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFaint" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#17EC4899" Offset="0"/>
        <GradientStop Color="#178B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSoftLine" Color="#24D68CE6"/>
    <SolidColorBrush x:Key="AccentLine" Color="#38D68CE6"/>
    <Color x:Key="AccentGlow">#A73CC8</Color>

    <SolidColorBrush x:Key="Good" Color="#3FB950"/>
    <SolidColorBrush x:Key="GoodBg" Color="#263B2C"/>
    <SolidColorBrush x:Key="GoodBgHover" Color="#2F4D37"/>
    <SolidColorBrush x:Key="GoodSoft" Color="#143FB950"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerText" Color="#F47067"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#24F47067"/>
    <SolidColorBrush x:Key="DangerLine" Color="#73F47067"/>
    <SolidColorBrush x:Key="Warn" Color="#E3B341"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1FE3B341"/>
    <SolidColorBrush x:Key="Ingame" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="Offline" Color="#6B6B6B"/>
</ResourceDictionary>
