<UserControl x:Class="AxoClient.UI.InstanceTabs.ServersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                    Background="{StaticResource Accent}" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Hinzufügen"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="0,0,8,0"
                    ToolTip="Status aktualisieren" Click="Refresh_Click"/>
            <TextBlock x:Name="Header" Text="Server" Foreground="White" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                   Visibility="Collapsed" Text="Noch keine Server gespeichert. Klicke oben rechts auf &quot;Hinzufügen&quot;."/>

        <ListBox x:Name="ServerList" Style="{StaticResource CardList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="6" Background="#22FFFFFF"
                                Margin="0,0,12,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72D;"
                                    ToolTip="Einem Freund schicken" Margin="0,0,6,0" Click="Share_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Bearbeiten"
                                    Margin="0,0,6,0" Click="Edit_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Entfernen"
                                    Margin="0,0,10,0" Click="Delete_Click"/>
                            <Button Style="{StaticResource LauncherButton}" Background="{StaticResource Accent}"
                                    Content="Beitreten" Click="Join_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="White" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                <Run Text="{Binding Address, Mode=OneWay}" Foreground="{StaticResource MutedText}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                <Setter Property="Foreground" Value="#6FCF97"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
