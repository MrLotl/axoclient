<UserControl x:Class="AxoClient.UI.InstanceTabs.ServersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <c:PingBrushConverter x:Key="PingBrush"/>

        <DataTemplate x:Key="Actions">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActButton}" ToolTip="An Freunde senden" Click="Share_Click">
                    <c:Icon Kind="Send" Size="14"/>
                </Button>
                <Button Style="{StaticResource ActButton}" ToolTip="Bearbeiten" Click="Edit_Click">
                    <c:Icon Kind="Pencil" Size="14"/>
                </Button>
                <Button Style="{StaticResource ActTrash}" ToolTip="Entfernen" Click="Delete_Click">
                    <c:Icon Kind="Trash" Size="14"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Ping">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}">
                <c:PingBars Level="{Binding PingLevel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding PingText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{Binding PingLevel, Converter={StaticResource PingBrush}}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ServerIcon">
            <Grid>
                <Border CornerRadius="12" Background="{StaticResource RowBg}">
                    <c:Icon Kind="Server" Size="26" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="10" Margin="0,0,16,16">
                <StackPanel>
                    <Grid Height="120" ClipToBounds="True">
                        <Border CornerRadius="8" Background="#1C1C1C"/>
                        <Border CornerRadius="8" Opacity="0.5" ClipToBounds="True">
                            <Border Margin="-30">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="24"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ContentPresenter Width="64" Height="64" Content="{Binding}" ContentTemplate="{StaticResource ServerIcon}"
                                          Effect="{StaticResource SoftShadow}"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Height="22" Padding="8,0"
                                CornerRadius="6" Background="#80000000">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Users" Size="11" Foreground="#F2F2F2" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding PlayersText}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F2F2"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Height="22" Padding="8,0"
                                CornerRadius="6" Background="#80000000">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Ping}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="2,10,2,0"/>
                    <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis" Margin="2,2,2,10"/>
                    <DockPanel Margin="2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallGoodButton}" Height="30" FontSize="12"
                                Padding="14,0" Click="Join_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Join" Size="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Beitreten" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Actions}" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate">
            <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="8,8,12,8" Margin="0,0,0,8">
                <DockPanel>
                    <ContentPresenter DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,14,0" Content="{Binding}"
                                      ContentTemplate="{StaticResource ServerIcon}"/>
                    <StackPanel DockPanel.Dock="Left" Width="190" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallGoodButton}" Width="110" FontSize="13" Margin="6,0,0,0"
                            Click="Join_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Join" Size="14" Margin="0,0,7,0"/>
                            <TextBlock Text="Beitreten" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Actions}"
                                      VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Width="140" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Ping}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding PlayersText, StringFormat='{}{0} Spieler'}" FontSize="12"
                                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Motd}" FontSize="12" Foreground="{StaticResource DimText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <UniformGrid Columns="4" VerticalAlignment="Top" Margin="0,0,-16,0"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBox x:Name="FilterBox" DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="260"
                     c:Field.Hint="Server durchsuchen…" TextChanged="Filter_TextChanged"/>
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}"
                    Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GridToggle" Style="{StaticResource SegmentIconButton}" GroupName="ServerView"
                                 ToolTip="Kartenansicht" Checked="ViewToggle_Checked">
                        <c:Icon Kind="Grid" Size="16"/>
                    </RadioButton>
                    <RadioButton x:Name="ListToggle" Style="{StaticResource SegmentIconButton}" GroupName="ServerView"
                                 ToolTip="Listenansicht" Margin="2,0,0,0" Checked="ViewToggle_Checked">
                        <c:Icon Kind="List" Size="16"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Refresh" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Aktualisieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0" c:Field.Corner="8"
                        Margin="10,0,0,0" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Plus" Size="16" StrokeWidth="1.8" Margin="0,0,8,0"/>
                        <TextBlock Text="Server hinzufügen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource MutedText}" Margin="10,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <Grid>
            <ItemsControl x:Name="ServerList" Style="{StaticResource PlainList}" Margin="0,0,-8,0" Padding="0,0,8,0"/>
            <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
