<UserControl x:Class="AxoClient.UI.InstanceTabs.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel Margin="0,0,12,0">
            <TextBlock Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Jedes Profil ist ein eigener Satz aller Overlay-Einstellungen. Eingestellt werden sie im Spiel (rechte Umschalttaste). Hier verwaltest du die Profile: aktivieren, Server zuordnen, kopieren, teilen, löschen. „Standard“ gibt es immer und gilt überall, wo kein anderes Profil passt."/>
            <TextBlock x:Name="RunningNote" Foreground="#E3A66D" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="Collapsed"
                       Text="Minecraft läuft gerade. Beende es, um Profile zu ändern oder zu wechseln – sonst würde das Spiel die Änderungen wieder überschreiben."/>
            <ItemsControl x:Name="ProfileItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LauncherButton}" Content="Aktivieren" Padding="12,6"
                                            Click="Activate_Click"
                                            Visibility="{Binding CanActivate, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Style="{StaticResource LauncherButton}" Content="Server" Padding="12,6"
                                            Margin="6,0,0,0" Click="Servers_Click"
                                            ToolTip="Server, auf denen das Profil automatisch gilt"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Style="{StaticResource LauncherButton}" Content="Teilen" Padding="12,6"
                                            Margin="6,0,0,0" Click="Share_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                                            Content="&#xE8C8;" Margin="6,0,0,0" ToolTip="Kopieren" Click="Copy_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                                            Content="&#xE74D;" Margin="6,0,0,0" ToolTip="Löschen" Click="Delete_Click"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"
                                                   FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="6,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="aktiv" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedText}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
