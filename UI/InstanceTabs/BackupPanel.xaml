<UserControl x:Class="AxoClient.UI.InstanceTabs.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenFolderButton" Style="{StaticResource IconButton}" Content="&#xE838;"
                        ToolTip="Ordner mit den Sicherungen öffnen" Margin="0,0,8,0" Click="OpenFolder_Click"/>
                <Button x:Name="CreateButton" Style="{StaticResource LauncherButton}"
                        Background="{StaticResource Accent}" Content="Sicherung erstellen" Click="Create_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Header" Text="Sicherungen" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubHeader" Foreground="{StaticResource MutedText}" FontSize="12"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,10,12,0"/>

        <Border x:Name="AsideBanner" DockPanel.Dock="Bottom" Background="#22E3A66D" CornerRadius="8"
                Padding="12,10" Margin="0,10,12,0" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}" Content="Endgültig löschen"
                        Padding="12,6" Margin="12,0,0,0" Click="CleanAside_Click"/>
                <TextBlock Foreground="#E3A66D" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Aus einer Wiederherstellung liegen noch Ordner mit der Endung „.vor-backup“ im Spielordner. Wenn alles läuft, kannst du sie löschen."/>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                       VerticalAlignment="Top" Visibility="Collapsed"
                       Text="Noch keine Sicherung. Mit „Sicherung erstellen“ legst du eine ZIP-Datei mit Welten, Mods und Einstellungen an – zum Beispiel, bevor du Mods aktualisierst oder die Minecraft-Version hochziehst."/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="BackupList" Margin="0,0,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource LauncherButton}" Content="Wiederherstellen"
                                                Padding="12,6" Click="Restore_Click"/>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                                                Content="&#xE74D;" Margin="6,0,0,0" ToolTip="Sicherung löschen"
                                                Click="Delete_Click"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedText}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
