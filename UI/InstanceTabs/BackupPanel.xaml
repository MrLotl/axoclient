<UserControl x:Class="AxoClient.UI.InstanceTabs.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenFolderButton" Style="{StaticResource IconButton}" ToolTip="Ordner mit den Sicherungen öffnen"
                        Margin="0,0,8,0" Click="OpenFolder_Click">
                    <c:Icon Kind="Folder" Size="15"/>
                </Button>
                <Button x:Name="CreateButton" Style="{StaticResource SmallPrimaryButton}" Click="Create_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Plus" Size="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Sicherung erstellen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Header" Text="Sicherungen" Style="{StaticResource CardTitle}" FontSize="14"/>
                <TextBlock x:Name="SubHeader" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

        <Border x:Name="AsideBanner" DockPanel.Dock="Bottom" Background="{StaticResource WarnSoft}" CornerRadius="10"
                Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Endgültig löschen" Margin="12,0,0,0"
                        Click="CleanAside_Click"/>
                <TextBlock Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Aus einer Wiederherstellung liegen noch Ordner mit der Endung „.vor-backup“ im Spielordner. Wenn alles läuft, kannst du sie löschen."/>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                       VerticalAlignment="Top" Margin="0,16,0,16" Visibility="Collapsed"
                       Text="Noch keine Sicherung. „Sicherung erstellen“ legt eine ZIP-Datei mit Welten, Mods und Einstellungen an – zum Beispiel vor einem Update."/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <ItemsControl x:Name="BackupList" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource RowBgSoft}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallButton}" Click="Restore_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <c:Icon Kind="History" Size="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="Wiederherstellen" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource TrashButton}" Width="30" Height="30" Margin="6,0,0,0"
                                                ToolTip="Sicherung löschen" Click="Delete_Click">
                                            <c:Icon Kind="Trash" Size="14"/>
                                        </Button>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,12,0">
                                        <c:Icon Kind="Archive" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource RowSub}" Foreground="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
