<UserControl x:Class="AxoClient.UI.InstanceTabs.WorldsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
    <UserControl.Resources>
        <c:ModeBrushConverter x:Key="ModeBrush"/>

        <DataTemplate x:Key="Actions">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActButton}" ToolTip="Backup dieser Welt erstellen" Click="Backup_Click">
                    <c:Icon Kind="Archive" Size="14"/>
                </Button>
                <Button Style="{StaticResource ActButton}" ToolTip="Weltordner öffnen" Click="OpenWorld_Click">
                    <c:Icon Kind="Folder" Size="14"/>
                </Button>
                <Button Style="{StaticResource ActTrash}" ToolTip="In den Papierkorb verschieben" Click="Delete_Click">
                    <c:Icon Kind="Trash" Size="14"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Thumb">
            <Grid>
                <Border Background="#1C1C1C">
                    <c:Icon Kind="Map" Size="24" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="10" Margin="0,0,16,16">
                <StackPanel>
                    <c:AspectBox>
                        <Grid>
                            <Border CornerRadius="8" ClipToBounds="True">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}"/>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,4" CornerRadius="6"
                                    Background="{Binding GameMode, Converter={StaticResource ModeBrush}}">
                                <TextBlock Text="{Binding GameMode}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                            </Border>
                        </Grid>
                    </c:AspectBox>
                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="2,10,2,0"/>
                    <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis" Margin="2,2,2,10"/>
                    <DockPanel Margin="2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallGoodButton}" Height="30" FontSize="12" Padding="12,0"
                                Click="Play_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Play" Size="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Spielen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Actions}" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate">
            <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="8,8,12,8" Margin="0,0,0,8">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="96" Height="54" CornerRadius="6" ClipToBounds="True" Margin="0,0,14,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallGoodButton}" Width="110" FontSize="13" Margin="6,0,0,0"
                            Click="Play_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Play" Size="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Spielen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Actions}"
                                      VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ModeLine}" FontSize="12" Foreground="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <UniformGrid Columns="4" VerticalAlignment="Top" Margin="0,0,-16,0"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBox x:Name="FilterBox" DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="260"
                     c:Field.Hint="Welten durchsuchen…" TextChanged="Filter_TextChanged"/>
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}"
                    Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GridToggle" Style="{StaticResource SegmentIconButton}" GroupName="WorldView"
                                 ToolTip="Kartenansicht" Checked="ViewToggle_Checked">
                        <c:Icon Kind="Grid" Size="16"/>
                    </RadioButton>
                    <RadioButton x:Name="ListToggle" Style="{StaticResource SegmentIconButton}" GroupName="WorldView"
                                 ToolTip="Listenansicht" Margin="2,0,0,0" Checked="ViewToggle_Checked">
                        <c:Icon Kind="List" Size="16"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Width="36" Padding="0" ToolTip="Weltenordner öffnen" Click="OpenSaves_Click">
                    <c:Icon Kind="Folder" Size="16"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Width="36" Padding="0" Margin="8,0,0,0" ToolTip="Backup-Ordner öffnen"
                        Click="OpenBackups_Click">
                    <c:Icon Kind="Archive" Size="16"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0" c:Field.Corner="8"
                        Margin="10,0,0,0" Click="Import_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Import" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Welt importieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource MutedText}" Margin="10,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <Grid>
            <ItemsControl x:Name="WorldList" Style="{StaticResource PlainList}" Margin="0,0,-8,0" Padding="0,0,8,0"/>
            <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
