<UserControl x:Class="AxoClient.UI.InstanceTabs.InstanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             xmlns:tabs="clr-namespace:AxoClient.UI.InstanceTabs">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionHead" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="LoaderButton" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="GroupName" Value="Loader"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel x:Name="CreateHeader" DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="34" Height="34" Background="{StaticResource CardBg}"
                    Foreground="#BDBDBD" ToolTip="Zurück zu den Instanzen" Click="Cancel_Click" Margin="0,0,14,0">
                <c:Icon Kind="ChevronLeft" Size="16"/>
            </Button>
            <Border DockPanel.Dock="Right" Height="52" CornerRadius="12" Background="{StaticResource CardBg}" Padding="6,6,14,6"
                    MaxWidth="360">
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="40" CornerRadius="7" ClipToBounds="True" x:Name="PreviewThumb"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewName" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                        <TextBlock x:Name="PreviewVersion" FontSize="12" Foreground="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Neue Instanz" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Alles hier kannst du später in den Instanz-Einstellungen ändern" FontSize="12.5"
                           Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerSoft}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Click="Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Trash" Size="15" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DeleteText" Text="Instanz löschen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="CreateProgress" Width="220" Margin="0,0,16,0" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="CreatePercent" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentText}"/>
                            <TextBlock x:Name="CreateStage" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ProgressBar x:Name="CreateBar" Maximum="100" IsIndeterminate="True"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="CancelButton" Style="{StaticResource ToolButton}" Height="38" Padding="18,0" Content="Abbrechen"
                            Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="20,0"
                            c:Field.Corner="8" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon x:Name="SaveIcon" Kind="Plus" Size="15" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SaveText" Text="Speichern" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="12.5" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,16" Padding="0,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHead}">
                            <TextBlock Text="Bilder" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Wie die Instanz in der Liste und oben im Banner aussieht" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <Border x:Name="IconPreview" DockPanel.Dock="Left" Width="84" Height="84" CornerRadius="12"
                                    Effect="{StaticResource SoftShadow}" Margin="0,0,14,0" AllowDrop="True"
                                    DragOver="Image_DragOver" Drop="Icon_Drop" Cursor="Hand" MouseLeftButtonUp="IconPreview_Click"
                                    ToolTip="Klicken oder Bild hierher ziehen"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Width="32" Padding="0" Margin="8,0,0,0"
                                    Foreground="#BDBDBD" ToolTip="Instanzbild zurücksetzen" Click="ResetIcon_Click">
                                <c:Icon Kind="Reset" Size="14"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="ChooseIcon_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="Image" Size="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Ändern" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Instanzbild" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="IconInfo" Text="Für Karten und Liste · ideal 16:9" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Height="92" Margin="0,0,0,10">
                            <Border x:Name="BannerPreview" CornerRadius="10" Background="#1C1C1C" AllowDrop="True"
                                    DragOver="Image_DragOver" Drop="Banner_Drop"/>
                            <Border CornerRadius="10" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D9181818" Offset="0"/>
                                        <GradientStop Color="#59181818" Offset="0.7"/>
                                        <GradientStop Color="#1A181818" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="BannerName" FontSize="13" FontWeight="Bold" Foreground="White" Margin="12,0,0,10"
                                       VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                            <Border x:Name="BannerAutoBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Height="20"
                                    Padding="7,0" CornerRadius="10" Background="{StaticResource Accent}" Opacity="0.9">
                                <TextBlock Text="Automatisch" FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Width="32" Padding="0" Margin="8,0,0,0"
                                    Foreground="#BDBDBD" ToolTip="Bannerbild zurücksetzen" Click="ResetBanner_Click">
                                <c:Icon Kind="Reset" Size="14"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="ChooseBanner_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="Image" Size="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Ändern" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="AutoBanner_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="Wand" Size="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="An Instanzbild anpassen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Bannerbild" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHead}">
                            <TextBlock Text="Allgemein" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Name, Mod-Loader und Spielversion" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource LauncherTextBox}" Height="38" c:Field.Corner="8"
                                 c:Field.Hint="z. B. Hardcore mit Freunden" BorderBrush="#333333" Margin="0,0,0,16"
                                 TextChanged="Name_TextChanged"/>
                        <TextBlock Text="Mod-Loader" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,16">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="VanillaRadio" Style="{StaticResource LoaderButton}" Content="Vanilla" Checked="Loader_Checked"/>
                                <RadioButton x:Name="FabricRadio" Style="{StaticResource LoaderButton}" Content="Fabric" Checked="Loader_Checked"/>
                                <RadioButton x:Name="ForgeRadio" Style="{StaticResource LoaderButton}" Content="Forge" Checked="Loader_Checked"/>
                                <RadioButton x:Name="NeoForgeRadio" Style="{StaticResource LoaderButton}" Content="NeoForge" Checked="Loader_Checked"/>
                                <RadioButton x:Name="QuiltRadio" Style="{StaticResource LoaderButton}" Content="Quilt" Checked="Loader_Checked"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Minecraft-Version" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="VersionBox" Style="{StaticResource LauncherCombo}" Height="38" SelectionChanged="Version_SelectionChanged"/>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="AxoOnlyCheck" Content="Nur AxoClient-kompatible" Margin="0,0,18,8" Click="Filter_Click"
                                      ToolTip="Nur Versionen, für die AxoClient die Mod mitbringt (Symbol in der Tabliste, Umhänge, Freunde)"/>
                            <CheckBox x:Name="SnapshotsCheck" Content="Snapshots anzeigen" Margin="0,0,18,8" Click="Filter_Click"/>
                            <CheckBox x:Name="OldVersionsCheck" Content="Alpha/Beta anzeigen" Margin="0,0,0,8" Click="Filter_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="IncompatibleText" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="Diese Version wird von AxoClient nicht unterstützt. Das Spiel startet ohne AxoClient-Funktionen."/>
                        <TextBlock x:Name="InfoText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SourceSection" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHead}" Margin="0,0,0,14">
                            <TextBlock Text="Ausgangspunkt" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Womit die Instanz startet" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <UniformGrid Rows="1" Margin="0,0,-10,0">
                            <RadioButton x:Name="SourceEmpty" Style="{StaticResource PickCard}" GroupName="Source" Margin="0,0,10,0"
                                         IsChecked="True" Checked="Source_Checked" Tag="Plus|Leer|Frische Instanz ohne Inhalte"/>
                            <RadioButton x:Name="SourceCopy" Style="{StaticResource PickCard}" GroupName="Source" Margin="0,0,10,0"
                                         Checked="Source_Checked" Tag="Copy|Kopieren|Inhalte einer anderen Instanz übernehmen"/>
                            <RadioButton x:Name="SourceImport" Style="{StaticResource PickCard}" GroupName="Source" Margin="0,0,10,0"
                                         Checked="Source_Checked" Tag="Import|Importieren|Aus Datei oder anderem Launcher"/>
                            <RadioButton x:Name="SourcePack" Style="{StaticResource PickCard}" GroupName="Source" Margin="0,0,10,0"
                                         Checked="Source_Checked" Tag="Download|Modpack|Fertiges Paket von Modrinth"/>
                        </UniformGrid>
                        <Border x:Name="CopyPanel" Style="{StaticResource Inset}" Background="#242424" Margin="0,12,0,0"
                                Visibility="Collapsed">
                            <tabs:TransferPanel x:Name="Transfer"/>
                        </Border>
                        <Border x:Name="ImportPanel" Height="76" CornerRadius="10" BorderBrush="#3A3A3A" BorderThickness="1.5"
                                Margin="0,12,0,0" Cursor="Hand" Background="Transparent" AllowDrop="True" Visibility="Collapsed"
                                MouseLeftButtonUp="ImportFile_Click" DragOver="Image_DragOver" Drop="ImportFile_Drop">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:Icon Kind="Upload" Size="18" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
                                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center">
                                    <Run Text="Datei auswählen" Foreground="{StaticResource TextStrong}" FontWeight="SemiBold"/>
                                    <Run Text=" oder hierher ziehen · .zip, .mrpack, CurseForge-Export"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ForeignPanel" Style="{StaticResource Inset}" Background="#242424" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Andere Launcher durchsuchen"
                                        Click="Foreign_Click"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           Text="Instanzen aus Modrinth App, CurseForge, Prism, Lunar, Feather und anderen übernehmen."/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="PackPanel" Style="{StaticResource Inset}" Background="#242424" Margin="0,12,0,0"
                                Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="Modpacks_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Modpacks ansehen" VerticalAlignment="Center"/>
                                        <c:Icon Kind="ArrowRight" Size="13" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Caption}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           Text="Modpacks bringen Version, Loader und Mods selbst mit – sie werden auf der Modpack-Seite installiert."/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="3" Style="{StaticResource SectionHead}">
                            <TextBlock Text="Leistung &amp; Java" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Arbeitsspeicher und Start-Argumente für diese Instanz" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <DockPanel>
                                <TextBlock x:Name="RamValue" DockPanel.Dock="Right" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextStrong}"/>
                                <TextBlock Text="Arbeitsspeicher" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </DockPanel>
                            <Slider x:Name="RamSlider" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,4" ValueChanged="Ram_ValueChanged"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="1 GB" FontSize="11" Foreground="{StaticResource DimText}"/>
                                <TextBlock x:Name="RamMax" DockPanel.Dock="Right" Text="16 GB" FontSize="11"
                                           Foreground="{StaticResource DimText}"/>
                                <TextBlock x:Name="RamHint" FontSize="11" Foreground="{StaticResource DimText}"
                                           HorizontalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Java-Argumente" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="JvmArgsBox" Style="{StaticResource MultiLineTextBox}" Height="76" c:Field.Corner="8"
                                     BorderBrush="#333333" TextChanged="Dirty_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ManageSection" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHead}" Margin="0,0,0,8">
                            <TextBlock Text="Verwaltung" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Sichern, Daten übernehmen und auf neuere Versionen umziehen" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <DockPanel Margin="0,10,0,0">
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,12,0">
                                <c:Icon Kind="Archive" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Sicherungen öffnen"
                                    Click="Backups_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sicherungen" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock x:Name="BackupInfo" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Welten, Mods und Einstellungen als ZIP sichern und wiederherstellen"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,12,0">
                                <c:Icon Kind="Swap" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Daten übernehmen"
                                    Click="Transfer_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Aus anderer Instanz übernehmen" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Welten, Server, Einstellungen oder Inhalte einer anderen Instanz kopieren"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,12,0">
                                <c:Icon Kind="ArrowUp" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Upgrade starten"
                                    Click="Upgrade_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auf neuere Minecraft-Version hochziehen" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Legt eine Kopie mit neuerer Version an und sucht passende Mods dazu"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
