<UserControl x:Class="AxoClient.UI.InstanceTabs.InstanceOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel Margin="0,0,12,0">
            <ItemsControl x:Name="StatsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="20" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedText}"
                                           FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Spielzeit" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="PlaySummary" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <ItemsControl x:Name="PlayChart" Height="90">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0" ToolTip="{Binding Tip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="3"/>
                                    <Border Grid.Row="0" Height="{Binding BarHeight}" VerticalAlignment="Bottom"
                                            CornerRadius="3" Background="{Binding Fill}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" Margin="0,4,0,0"
                                               HorizontalAlignment="Center" Foreground="{Binding LabelBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Arbeitsspeicher" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12">
                <DockPanel>
                    <Button x:Name="RamButton" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                            Background="{StaticResource Accent}" Content="Empfehlung übernehmen" Padding="12,6"
                            Margin="12,0,0,0" Click="Ram_Click"/>
                    <TextBlock x:Name="RamText" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <TextBlock Text="Abstürze" Style="{StaticResource SectionTitle}" Margin="0,20,0,8"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}" Content="Analysieren"
                            Padding="12,6" Margin="12,0,0,0" Click="Crash_Click"/>
                    <TextBlock x:Name="CrashText" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
