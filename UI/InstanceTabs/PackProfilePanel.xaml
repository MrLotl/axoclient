<UserControl x:Class="AxoClient.UI.InstanceTabs.PackProfilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" Click="Capture_Click"
                    ToolTip="Nimmt die gerade aktiven Ressourcepacks und den eingestellten Shader als neues Profil auf">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="Plus" Size="14" Margin="0,0,7,0"/>
                    <TextBlock Text="Profil aus jetzigem Stand" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Header" Text="Paket-Profile" Style="{StaticResource CardTitle}" FontSize="14"/>
                <TextBlock x:Name="SubHeader" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                           Text="Ein Profil merkt sich, welche Ressourcepacks aktiv sind und welcher Shader läuft. Du kannst es von Hand anwenden oder Servern zuordnen – startest du auf einen dieser Server, wird das Profil vorher gesetzt."/>
                <Border x:Name="RunningNote" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                        Background="{StaticResource WarnSoft}" Visibility="Collapsed">
                    <TextBlock Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap"
                               Text="Minecraft läuft gerade. Änderungen hier würde das Spiel beim Beenden überschreiben – schließe es zuerst."/>
                </Border>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,8"
                           TextAlignment="Center" Visibility="Collapsed"
                           Text="Noch kein Profil. Stelle die Pakete so ein, wie du sie haben willst, und nimm den Stand oben als Profil auf."/>

                <ItemsControl x:Name="ProfileItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource RowBgSoft}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallPrimaryButton}" Content="Anwenden" Click="Apply_Click"
                                                ToolTip="Ressourcepacks und Shader jetzt auf dieses Profil setzen"/>
                                        <Button Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="Servers_Click"
                                                ToolTip="Server, auf denen das Profil automatisch gesetzt wird">
                                            <StackPanel Orientation="Horizontal">
                                                <c:Icon Kind="Server" Size="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="Server" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0"
                                                ToolTip="Umbenennen" Click="Rename_Click">
                                            <c:Icon Kind="Pencil" Size="14"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0"
                                                ToolTip="Mit dem jetzigen Stand überschreiben" Click="Update_Click">
                                            <c:Icon Kind="Refresh" Size="14"/>
                                        </Button>
                                        <Button Style="{StaticResource TrashButton}" Width="30" Height="30" Margin="6,0,0,0"
                                                ToolTip="Löschen" Click="Delete_Click">
                                            <c:Icon Kind="Trash" Size="14"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource RowSub}" Foreground="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
