<UserControl x:Class="AxoClient.UI.InstanceTabs.ContentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>

        <DataTemplate x:Key="Actions">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActButton}" ToolTip="An Freunde senden" Click="Share_Click"
                        IsEnabled="{Binding CanShare}">
                    <c:Icon Kind="Send" Size="14"/>
                </Button>
                <Button Style="{StaticResource ActButton}" ToolTip="Version ändern" Click="Version_Click"
                        IsEnabled="{Binding CanChangeVersion}">
                    <c:Icon Kind="Layers" Size="14"/>
                </Button>
                <Button Style="{StaticResource ActTrash}" ToolTip="Löschen" Click="Delete_Click">
                    <c:Icon Kind="Trash" Size="14"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StateControl">
            <Grid>
                <CheckBox Style="{StaticResource MiniSwitch}" IsChecked="{Binding Active, Mode=OneWay}"
                          ToolTip="Aktiviert" Click="Toggle_Click"
                          Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}"/>
                <Border Style="{StaticResource Tag}" Background="{StaticResource AccentSoft}" Height="24" Padding="9,0"
                        Visibility="{Binding ShowActiveBadge, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Check" Size="11" Foreground="{StaticResource AccentText}" Margin="0,0,5,0"/>
                        <TextBlock Text="Aktiv" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SmallButton}" Height="28" FontSize="12" Content="Aktivieren"
                        Click="Activate_Click"
                        Visibility="{Binding ShowActivate, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="10" Margin="0,0,16,16"
                    Opacity="{Binding Dimmed}">
                <StackPanel>
                    <c:AspectBox>
                        <Grid ClipToBounds="True">
                            <Border CornerRadius="8" Background="#1C1C1C"/>
                            <Border CornerRadius="8" Opacity="0.45" ClipToBounds="True">
                                <Border Margin="-30" CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="22"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                            <Grid Margin="0,18" HorizontalAlignment="Center"
                                  Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                                <Border CornerRadius="18" Background="{Binding LetterBrush}" Effect="{StaticResource SoftShadow}">
                                    <Viewbox Margin="22">
                                        <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="White"/>
                                    </Viewbox>
                                </Border>
                                <Border CornerRadius="18">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Height="22" Padding="8,0"
                                    CornerRadius="11" Background="#333FB950"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Update verfügbar" FontSize="11" FontWeight="SemiBold" Foreground="#6FDC80"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </c:AspectBox>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="2,10,2,0" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis" Margin="2,2,2,10"/>
                    <DockPanel Margin="2,0">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}"
                                          ContentTemplate="{StaticResource StateControl}" VerticalAlignment="Center"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Actions}"
                                          HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate">
            <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="8,8,12,8" Margin="0,0,0,8"
                    Opacity="{Binding Dimmed}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0">
                        <Border CornerRadius="10" Background="{Binding LetterBrush}">
                            <TextBlock Text="{Binding Letter}" FontSize="18" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="10">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel DockPanel.Dock="Left" Width="220" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource StateControl}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource Actions}"
                                      VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right" Height="22" Padding="8,0" CornerRadius="11" Background="#293FB950"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Update" FontSize="11" FontWeight="SemiBold" Foreground="#6FDC80"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <c:TileGrid TileWidth="280" VerticalAlignment="Top" Margin="0,0,-16,0"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBox x:Name="FilterBox" DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="260"
                     Background="{StaticResource CardBg}" TextChanged="Filter_TextChanged"/>
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}"
                    Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GridToggle" Style="{StaticResource SegmentIconButton}" GroupName="ContentView"
                                 ToolTip="Kartenansicht" Checked="ViewToggle_Checked">
                        <c:Icon Kind="Grid" Size="16"/>
                    </RadioButton>
                    <RadioButton x:Name="ListToggle" Style="{StaticResource SegmentIconButton}" GroupName="ContentView"
                                 ToolTip="Listenansicht" Margin="2,0,0,0" Checked="ViewToggle_Checked">
                        <c:Icon Kind="List" Size="16"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Width="36" Padding="0" ToolTip="Ordner öffnen"
                        Click="OpenFolder_Click">
                    <c:Icon Kind="Folder" Size="16"/>
                </Button>
                <Button x:Name="ProfilesButton" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        ToolTip="Paket-Profile: Zusammenstellungen von Ressourcepacks speichern und wechseln"
                        Click="Profiles_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Layers" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Profile" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RepairButton" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Repair_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Wrench" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Reparieren" VerticalAlignment="Center"/>
                        <Border x:Name="IssueBadge" MinWidth="18" Height="18" CornerRadius="9" Padding="5,0"
                                Margin="8,0,0,0" Background="#2EE3B341" Visibility="Collapsed">
                            <TextBlock x:Name="IssueCount" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Warn}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="UpdatesButton" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Updates_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Refresh" Size="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="UpdatesText" Text="Nach Updates suchen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0"
                        Margin="8,0,0,0" c:Field.Corner="8" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Plus" Size="16" StrokeWidth="1.8" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AddText" Text="Mods hinzufügen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource MutedText}" Margin="10,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border x:Name="HintPanel" DockPanel.Dock="Top" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                Background="{StaticResource WarnSoft}" BorderBrush="#40E3B341" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <c:Icon DockPanel.Dock="Left" Kind="Info" Size="16" Foreground="{StaticResource Warn}" Margin="0,0,10,0"
                        VerticalAlignment="Center"/>
                <Button x:Name="HintButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                        Click="HintButton_Click"/>
                <TextBlock x:Name="HintText" Foreground="{StaticResource SubtleText}" FontSize="12.5" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <Grid>
            <ItemsControl x:Name="Items" Style="{StaticResource PlainList}" Margin="0,0,-8,0" Padding="0,0,8,0"/>
            <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,40,0,0" TextAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
