<UserControl x:Class="AxoClient.UI.InstanceTabs.ScreenshotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Liste neu laden"
                        Margin="0,0,8,0" Click="Reload_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Ordner „screenshots“ öffnen"
                        Click="OpenFolder_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Header" Text="Screenshots" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubHeader" Foreground="{StaticResource MutedText}" FontSize="12"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,10,12,0"/>

        <Grid>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                       VerticalAlignment="Top" Visibility="Collapsed"
                       Text="Noch keine Bildschirmfotos. Drücke im Spiel F2 – die Bilder landen dann hier und lassen sich umbenennen, kopieren oder als Bild der Instanz setzen."/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="ShotList" Margin="0,0,12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="216" Margin="0,0,12,14">
                                <Border Height="122" CornerRadius="8" Background="#1AFFFFFF" ClipToBounds="True"
                                        Cursor="Hand" MouseLeftButtonUp="Open_Click"
                                        ToolTip="Klicken: im Bildbetrachter öffnen">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="2,8,2,0"
                                           ToolTip="{Binding FileName}"/>
                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedText}"
                                           FontSize="11" Margin="2,2,2,6" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE8AC;" ToolTip="Umbenennen" Click="Rename_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE8C8;" Margin="5,0,0,0" ToolTip="In die Zwischenablage kopieren"
                                            Click="Copy_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE749;" Margin="5,0,0,0" ToolTip="Als Bild der Instanz setzen"
                                            Click="SetIcon_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE74D;" Margin="5,0,0,0" ToolTip="In den Papierkorb"
                                            Click="Delete_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
