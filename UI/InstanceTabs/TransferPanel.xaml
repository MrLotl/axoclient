<UserControl x:Class="AxoClient.UI.InstanceTabs.TransferPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
        <TextBlock x:Name="IntroText" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Übernimm Welten, Einstellungen und Inhalte aus einer anderen Instanz oder dem offiziellen Minecraft Launcher."/>

        <TextBlock Text="Übertragen von" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="SourceBox" Style="{StaticResource LauncherCombo}" Height="42" Margin="0,0,0,14"
                  SelectionChanged="SourceBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleText}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel x:Name="ItemsPanel">
            <TextBlock Text="Was soll übernommen werden?" Style="{StaticResource FieldLabel}"/>
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <CheckBox x:Name="WorldsCheck" Margin="0,0,0,10"/>
                <CheckBox x:Name="OptionsCheck" Margin="0,0,0,10"/>
                <CheckBox x:Name="ServersCheck" Margin="0,0,0,10"/>
                <CheckBox x:Name="ResourcePacksCheck" Margin="0,0,0,10"/>
                <CheckBox x:Name="ShadersCheck" Margin="0,0,0,10"/>
                <CheckBox x:Name="ModsCheck" Margin="0,0,0,10"/>
            </UniformGrid>
            <TextBlock x:Name="HintText" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <Button x:Name="TransferButton" Style="{StaticResource LauncherButton}" Background="{StaticResource Accent}"
                    HorizontalAlignment="Left" Content="Übertragen" Click="Transfer_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource SubtleText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
