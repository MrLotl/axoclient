<UserControl x:Class="AxoClient.UI.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="#99000000">
        <Border x:Name="DialogBox" Background="#FF2B2D31" CornerRadius="12" Padding="24" Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="DialogTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ContentControl x:Name="DialogContent" Visibility="Collapsed"/>
                <ScrollViewer x:Name="DialogTextScroller" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                    </ScrollViewer.Resources>
                    <TextBox x:Name="DialogText" Foreground="{StaticResource SubtleText}" Background="Transparent"
                             BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <ProgressBar x:Name="DialogProgress" Height="6" Maximum="100" IsIndeterminate="True"
                                 Background="#552B2D31" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                    <TextBlock x:Name="DialogProgressText" Foreground="{StaticResource SubtleText}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="DialogCancel" Style="{StaticResource LauncherButton}" Content="Abbrechen"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="DialogOk" Style="{StaticResource LauncherButton}"
                            Background="{StaticResource Accent}" Content="OK" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
