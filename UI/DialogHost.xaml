<UserControl x:Class="AxoClient.UI.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             Visibility="Collapsed">
    <Grid x:Name="Backdrop" Background="#9E0A0A0A" MouseLeftButtonDown="Backdrop_MouseDown">
        <Border x:Name="DialogBox" Background="{StaticResource CardBg}" CornerRadius="16" Width="440"
                BorderBrush="{StaticResource PopupLine}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                MouseLeftButtonDown="DialogBox_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <DockPanel x:Name="StandardLayout">
                    <DockPanel DockPanel.Dock="Top" Margin="22,22,22,0">
                        <Border x:Name="IconTile" DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0"
                                VerticalAlignment="Top" Visibility="Collapsed">
                            <c:Icon x:Name="TitleIcon" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}"
                                VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="Schließen" Click="Cancel_Click">
                            <c:Icon Kind="Close" Size="14"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitle" Style="{StaticResource DialogTitle}"/>
                            <TextBlock x:Name="DialogSubtitle" Style="{StaticResource Body}" Foreground="{StaticResource MutedText}"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="Footer" DockPanel.Dock="Bottom" Padding="22,0,22,22">
                        <DockPanel>
                            <ContentControl x:Name="FooterLeft" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DialogCancel" Style="{StaticResource LauncherButton}" Content="Abbrechen"
                                        Margin="0,0,8,0" Click="Cancel_Click"/>
                                <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Content="OK"
                                        Click="Ok_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Margin="22,18,22,20">
                        <ContentControl x:Name="DialogContent" Visibility="Collapsed" Focusable="False"/>
                        <ScrollViewer x:Name="DialogTextScroller" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="DialogText" Foreground="{StaticResource SubtleText}" Background="Transparent"
                                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" FontSize="13"
                                     SelectionBrush="#D946EF"/>
                        </ScrollViewer>
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="DialogProgressPercent" DockPanel.Dock="Right" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                                <TextBlock x:Name="DialogProgressText" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentText}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar x:Name="DialogProgress" Maximum="100" IsIndeterminate="True"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <ContentControl x:Name="CustomContent" Visibility="Collapsed" Focusable="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
