<Window x:Class="AxoClient.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AxoClient.UI"
        xmlns:pages="clr-namespace:AxoClient.UI.Pages"
        Title="AxoClient" Icon="/Assets/axoclient.ico" Height="700" Width="1180" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#1E1F22"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Tag" Value="#1FFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid ClipToBounds="True">
            <Image Source="/Assets/background.jpg" Stretch="UniformToFill" Margin="-40">
                <Image.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>
            <Rectangle Fill="#66000000"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#D91A1B1E" Padding="14,0,14,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="8,4,0,16">
                        <Image Source="/Assets/axolotl.png" Width="34" Height="28" Margin="-4,0,6,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AxoClient" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedText}"
                               FontSize="11" Margin="4,8,0,0" Cursor="Hand" ToolTip="Klicken: nach Updates suchen"
                               MouseLeftButtonUp="VersionText_Click"/>

                    <ui:AccountPanel x:Name="Account" DockPanel.Dock="Bottom"/>

                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;"
                                     Content="Home" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavInstances" Style="{StaticResource NavButton}" Tag="&#xE8F1;"
                                     Content="Instanzen" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSkins" Style="{StaticResource NavButton}" Tag="&#xE77B;"
                                     Content="Skins" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGameLog" Style="{StaticResource NavButton}" Tag="&#xE756;"
                                     Content="Game Log" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                     Content="Einstellungen" Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,44,24,24">
                <pages:HomePage x:Name="HomePage"/>
                <pages:InstancesPage x:Name="InstancesPage" Visibility="Collapsed"/>
                <pages:SkinsPage x:Name="SkinsPage" Visibility="Collapsed"/>
                <pages:GameLogPage x:Name="GameLogPage" Visibility="Collapsed"/>
                <pages:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <ui:DialogHost x:Name="DialogHost"/>

        <Grid x:Name="DropOverlay" Background="#B31E1F22" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="14" Margin="26"
                    Background="#26FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="44" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Hier loslassen" Foreground="White" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource SubtleText}" FontSize="13" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                               Text="Mods (.jar), Ressourcenpakete und Shader (.zip), gesicherte Welten, Modpacks (.mrpack), geteilte AxoClient-Pakete (.json) und Bilder"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimieren"
                    Click="Minimize_Click"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                    ToolTip="Maximieren" Click="Maximize_Click"/>
            <Button Style="{StaticResource CaptionButton}" Tag="#E81123" Content="&#xE8BB;" ToolTip="Schließen"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
