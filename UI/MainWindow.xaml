<Window x:Class="AxoClient.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AxoClient.UI"
        xmlns:c="clr-namespace:AxoClient.UI.Controls"
        xmlns:pages="clr-namespace:AxoClient.UI.Pages"
        Title="AxoClient" Icon="/Assets/axoclient.ico" Height="800" Width="1280" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid x:Name="ShellContent">
            <StackPanel Orientation="Horizontal" Margin="19,10,0,0" Height="32" VerticalAlignment="Top"
                        HorizontalAlignment="Left">
                <TextBlock FontSize="28" VerticalAlignment="Center">
                    <Run Text="Axo" FontWeight="SemiBold" Foreground="#434343"/><Run Text="Client" FontWeight="Medium" Foreground="#3D3D3D"/>
                </TextBlock>
                <TextBlock x:Name="VersionText" FontSize="12" FontWeight="Medium" Foreground="#3D3D3D"
                           VerticalAlignment="Bottom" Margin="5,0,0,6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                        Height="32">
                <Button x:Name="UpdatePill" Style="{StaticResource ButtonBase}" Height="32" Padding="10,0,12,0"
                        Background="{StaticResource AccentSoft}" BorderBrush="#38D68CE6" BorderThickness="1"
                        Foreground="{StaticResource AccentTextBright}" FontSize="12.5" FontWeight="SemiBold"
                        c:Field.Corner="8" Margin="0,0,8,0" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="UpdatePill_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Download" Size="15" Margin="0,0,7,0"/>
                        <TextBlock Text="Update verfügbar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BellButton" Style="{StaticResource ChromeButton}" Margin="0,0,8,0"
                        ToolTip="Benachrichtigungen" Click="Bell_Click">
                    <Grid Width="16" Height="16">
                        <c:Icon Kind="Bell" Size="16"/>
                        <Border x:Name="BellBadge" Width="16" Height="16" CornerRadius="8" Background="#E83D3D"
                                BorderBrush="{StaticResource WindowBg}" BorderThickness="2"
                                Margin="0,-12,-12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="BellCount" FontFamily="{StaticResource UiFont}" FontSize="8.5" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="LoginButton" Style="{StaticResource SmallPrimaryButton}" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Login_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Microsoft" Size="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LoginText" Text="Anmelden" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ToggleButton x:Name="AccountButton" Height="32" Padding="4,4,6,4" Cursor="Hand"
                              WindowChrome.IsHitTestVisibleInChrome="True" FocusVisualStyle="{StaticResource FocusRing}"
                              ToolTip="Account-Menü" Checked="AccountButton_Checked">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="#242424" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Height="24" CornerRadius="5" ClipToBounds="True" Background="#333333">
                            <Image x:Name="AccountHead" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock x:Name="AccountName" FontSize="14" FontWeight="Medium" Margin="8,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                        <c:Icon x:Name="AccountChevron" Kind="ChevronDown" Size="16" Foreground="{StaticResource SubtleText}"
                                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <c:Icon.RenderTransform>
                                <RotateTransform/>
                            </c:Icon.RenderTransform>
                        </c:Icon>
                    </StackPanel>
                </ToggleButton>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButton}" ToolTip="Minimieren" Click="Minimize_Click">
                        <c:Icon Kind="WinMin" Size="26"/>
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Margin="4,0" Click="Maximize_Click">
                        <c:Icon x:Name="MaximizeIcon" Kind="WinMax" Size="26"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" ToolTip="Schließen" Click="Close_Click">
                        <c:Icon Kind="WinClose" Size="26"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="NavBar" Width="66" Margin="0,56,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="Home" ToolTip="Home"
                             IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavInstances" Style="{StaticResource NavButton}" Tag="Library" ToolTip="Instanzen"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavServers" Style="{StaticResource NavButton}" Tag="Server" ToolTip="Lokale Server"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSkins" Style="{StaticResource NavButton}" Tag="User" ToolTip="Skins"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavConsole" Style="{StaticResource NavButton}" Tag="Console" ToolTip="Live-Konsole"
                             Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Gear" ToolTip="Einstellungen"
                             Checked="Nav_Checked"/>
            </StackPanel>

            <Border Margin="66,52,0,0" Background="{StaticResource ContentBg}" CornerRadius="18,0,0,0">
                <Grid x:Name="PageHost">
                    <pages:HomePage x:Name="HomePage"/>
                    <pages:InstancesPage x:Name="InstancesPage" Visibility="Collapsed"/>
                    <pages:LocalServersPage x:Name="LocalServersPage" Visibility="Collapsed"/>
                    <pages:SkinsPage x:Name="SkinsPage" Visibility="Collapsed"/>
                    <pages:GameLogPage x:Name="GameLogPage" Visibility="Collapsed"/>
                    <pages:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="AccountDismiss" Background="Transparent" Visibility="Collapsed"
                WindowChrome.IsHitTestVisibleInChrome="True" MouseDown="AccountDismiss_MouseDown"/>
        <ui:AccountMenu x:Name="AccountMenu" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>

        <ui:WelcomeView x:Name="Welcome" Visibility="Collapsed"/>

        <ui:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"/>

        <ui:DialogHost x:Name="DialogHost"/>

        <Grid x:Name="DropOverlay" Background="#B31F1F1F" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="#80D68CE6" BorderThickness="2" CornerRadius="16" Margin="26" Background="#08FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoft}"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <c:Icon Kind="Download" Size="28" Foreground="{StaticResource AccentText}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Hier loslassen" Foreground="{StaticResource TextStrong}" FontSize="22"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                               Text="Mods (.jar), Ressourcepacks und Shader (.zip), gesicherte Welten, Modpacks (.mrpack), geteilte AxoClient-Pakete (.json) und Bilder"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
