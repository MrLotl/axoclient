<UserControl x:Class="AxoClient.UI.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             Background="{StaticResource WindowBg}">
    <UserControl.Resources>
        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="c:Field.Corner" Value="12"/>
        </Style>
        <Style x:Key="SetupCard" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="BorderBrush" Value="#313131"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A3A3A3"/>
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7A7A7A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FeatureTile" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Storyboard x:Key="Float" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-12"
                             Duration="0:0:2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Ellipse Width="760" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-200,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#29EC4899" Offset="0"/>
                    <GradientStop Color="#128B5CF6" Offset="0.6"/>
                    <GradientStop Color="#001F1F1F" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="820" Height="640" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-260"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#248B5CF6" Offset="0"/>
                    <GradientStop Color="#001F1F1F" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel Orientation="Horizontal" Margin="19,10,0,0" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock FontSize="28" VerticalAlignment="Center">
                <Run Text="Axo" FontWeight="SemiBold" Foreground="#434343"/><Run Text="Client" FontWeight="Medium" Foreground="#3D3D3D"/>
            </TextBlock>
            <TextBlock x:Name="VersionText" FontSize="12" FontWeight="Medium" Foreground="#3D3D3D" VerticalAlignment="Bottom"
                       Margin="5,0,0,6"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,14,0">
            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimieren">
                <c:Icon Kind="WinMin" Size="26"/>
            </Button>
            <Button Style="{StaticResource WindowButton}" Margin="4,0,0,0" Click="Maximize_Click" ToolTip="Maximieren">
                <c:Icon Kind="WinMax" Size="26"/>
            </Button>
            <Button Style="{StaticResource WindowCloseButton}" Margin="4,0,0,0" Click="Close_Click" ToolTip="Schließen">
                <c:Icon Kind="WinClose" Size="26"/>
            </Button>
        </StackPanel>

        <Grid x:Name="StepWelcome" Margin="0,52,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="520"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="96,0,40,40">
                <Image Source="{StaticResource LogoAppIcon}" Width="64" Height="64" HorizontalAlignment="Left"/>
                <Border HorizontalAlignment="Left" Height="26" Padding="10,0" CornerRadius="13" Margin="0,14,0,0"
                        Background="{StaticResource AccentSoft}" BorderBrush="#38D68CE6" BorderThickness="1">
                    <TextBlock Text="Erster Start" FontSize="12" FontWeight="SemiBold" Foreground="#F5D0FB"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock FontSize="46" FontWeight="ExtraBold" Foreground="#F5F5F5" Margin="0,14,0,0" LineHeight="50"
                           LineStackingStrategy="BlockLineHeight">
                    <Run Text="Willkommen bei"/><LineBreak/><Run Text="AxoClient">
                        <Run.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F472B6" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Run.Foreground>
                    </Run>
                </TextBlock>
                <TextBlock MaxWidth="460" HorizontalAlignment="Left" FontSize="15" Foreground="#A3A3A3" TextWrapping="Wrap"
                           Margin="0,14,0,0" LineHeight="23"
                           Text="Melde dich mit deinem Microsoft-Konto an. Danach richten wir Java und deinen ersten Spielstart automatisch ein."/>

                <StackPanel MaxWidth="470" HorizontalAlignment="Left" Margin="0,30,0,0">
                    <DockPanel>
                        <Border Style="{StaticResource FeatureTile}">
                            <c:Icon Kind="Layers" Size="18" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Instanzen &amp; Modpacks" FontSize="14.5" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                            <TextBlock Text="Mods, Shader und Ressourcepacks pro Instanz – mit einem Klick installiert." FontSize="13"
                                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource FeatureTile}">
                            <c:Icon Kind="Users" Size="18" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Mit Freunden spielen" FontSize="14.5" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                            <TextBlock Text="Sieh, wer online ist, joine nach und teile ganze Instanzen." FontSize="13"
                                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource FeatureTile}">
                            <c:Icon Kind="Brush" Size="18" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Skins &amp; Axo-Capes" FontSize="14.5" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                            <TextBlock Text="Skins verwalten und eigene Capes direkt im Launcher pixeln." FontSize="13"
                                       Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <StackPanel MaxWidth="360" HorizontalAlignment="Left" Margin="0,30,0,0">
                    <Button x:Name="LoginButton" Style="{StaticResource BigButton}" Click="Login_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Microsoft" Size="17" Margin="0,0,10,0"/>
                            <TextBlock Text="Mit Microsoft anmelden" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LoginProblem" FontSize="12.5" Foreground="{StaticResource DangerText}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18"
                               Text="Du brauchst ein Konto mit Minecraft: Java Edition. AxoClient sieht dein Passwort nie – die Anmeldung läuft über Microsoft."/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1">
                <Ellipse Width="380" Height="380" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#38EC4899" Offset="0"/>
                            <GradientStop Color="#1A8B5CF6" Offset="0.6"/>
                            <GradientStop Color="#001F1F1F" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Image x:Name="HeroLogo" Source="{StaticResource LogoAppIcon}" Width="260" Height="260">
                    <Image.RenderTransform>
                        <TranslateTransform/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="20" Direction="270" Opacity="0.5" Color="Black"/>
                    </Image.Effect>
                </Image>
            </Grid>
        </Grid>

        <Grid x:Name="StepLogin" Margin="0,52,0,0" Visibility="Collapsed">
            <Border Width="460" Padding="32" CornerRadius="18" Background="#262626" BorderBrush="#333333" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource DialogShadow}">
                <StackPanel>
                    <Border Style="{StaticResource Spinner}" Width="40" Height="40" CornerRadius="20" BorderThickness="3.5"
                            HorizontalAlignment="Center">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D36AD8" Offset="0"/>
                                <GradientStop Color="#D36AD8" Offset="0.3"/>
                                <GradientStop Color="#3A3A3A" Offset="0.31"/>
                                <GradientStop Color="#3A3A3A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                    <TextBlock Text="Anmeldung bei Microsoft" FontSize="21" FontWeight="Bold" Foreground="#F2F2F2"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock FontSize="13.5" Foreground="#A3A3A3" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                               LineHeight="20"
                               Text="Wir haben das Anmeldefenster von Microsoft geöffnet. Melde dich dort mit deinem Konto an."/>
                    <TextBlock FontSize="12" Foreground="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,18,0,0"
                               Text="Der Launcher macht automatisch weiter, sobald du angemeldet bist. Schließe das Anmeldefenster, um abzubrechen."/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel x:Name="StepSetup" Margin="0,92,0,36" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="12" Effect="{StaticResource SoftShadow}">
                    <Border.Background>
                        <ImageBrush x:Name="SetupHead" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="HelloText" FontSize="26" FontWeight="ExtraBold" Foreground="#F5F5F5"/>
                    <TextBlock Text="Noch kurz einrichten, dann geht’s los." FontSize="14" Foreground="#A3A3A3" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" x:Name="FinishButton" Style="{StaticResource BigButton}" Width="280" Margin="0,0,0,10"
                    Click="Finish_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FinishText" Text="Fertig einrichten" VerticalAlignment="Center"/>
                    <c:Icon Kind="ArrowRight" Size="16" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>
            <Grid Width="760" VerticalAlignment="Top" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="RamValue" DockPanel.Dock="Right" FontSize="22" FontWeight="Bold" Foreground="#F2F2F2"/>
                            <TextBlock Text="Arbeitsspeicher" Style="{StaticResource CardLabel}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </DockPanel>
                        <Slider x:Name="RamSlider" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,10,0,10" ValueChanged="Ram_ValueChanged"/>
                        <TextBlock x:Name="RamHint" Style="{StaticResource CardNote}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="Java" Style="{StaticResource CardLabel}"/>
                        <DockPanel Margin="0,10,0,10">
                            <Border DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Good}">
                                <c:Icon Kind="Check" Size="13" StrokeWidth="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Automatisch" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource CardNote}"
                                   Text="Wird beim ersten Start passend zu jeder Minecraft-Version geladen – du musst nichts installieren."/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SetupCard}">
                    <StackPanel>
                        <TextBlock Text="Von anderen Launchern übernehmen" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="ImportNote" Style="{StaticResource CardNote}" Margin="0,3,0,12"
                                   Text="Suche nach anderen Launchern auf deinem PC …"/>
                        <ItemsControl x:Name="ImportList" Style="{StaticResource PlainList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" Margin="0,0,-8,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding Chosen, Mode=TwoWay}" Height="60" Margin="0,0,8,8" Cursor="Hand"
                                                  FocusVisualStyle="{StaticResource FocusRing}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd" Background="#2E2E2E" CornerRadius="10" Padding="12,0"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <DockPanel>
                                                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#1F1F1F"
                                                                BorderBrush="#4A4A4A" BorderThickness="1.5" Margin="0,0,12,0">
                                                            <c:Icon x:Name="Tick" Kind="Check" Size="12" StrokeWidth="2"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="Collapsed"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                                       Foreground="#F2F2F2"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                       Foreground="{StaticResource MutedText}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#38D68CE6"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#33303A"/>
                                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ImportStatus" Style="{StaticResource CardNote}" Foreground="{StaticResource AccentText}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <StackPanel x:Name="StepDone" Margin="0,52,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource Accent}" HorizontalAlignment="Center"
                    Effect="{StaticResource AccentShadow}">
                <c:Icon Kind="Check" Size="32" StrokeWidth="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Alles bereit!" FontSize="28" FontWeight="ExtraBold" Foreground="#F5F5F5" HorizontalAlignment="Center"
                       Margin="0,22,0,0"/>
            <TextBlock x:Name="DoneText" FontSize="14" Foreground="#A3A3A3" HorizontalAlignment="Center" Margin="0,6,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
            <Button Style="{StaticResource BigButton}" Width="260" Margin="0,22,0,0" Click="Close_Welcome_Click">
                <TextBlock Text="Zum Launcher"/>
            </Button>
        </StackPanel>

        <Grid x:Name="StepBack" Margin="0,52,0,0" Visibility="Collapsed">
            <Border Width="460" Padding="30" CornerRadius="20" Background="#EB262626" BorderBrush="#343434" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource DialogShadow}">
                <StackPanel>
                    <Image Source="{StaticResource LogoAppIcon}" Width="56" Height="56" HorizontalAlignment="Center"/>
                    <TextBlock Text="Willkommen zurück" FontSize="24" FontWeight="ExtraBold" Foreground="#F5F5F5"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock FontSize="13.5" Foreground="#A3A3A3" TextAlignment="Center" HorizontalAlignment="Center"
                               Margin="0,10,0,0" LineHeight="20" TextWrapping="Wrap"
                               Text="Deine Instanzen und Einstellungen sind noch da. Melde dich an, um weiterzuspielen."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <ItemsControl x:Name="InstanceStack" Style="{StaticResource PlainList}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="InstanceSummary" FontSize="12.5" Foreground="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="DEINE KONTEN" FontSize="11" FontWeight="SemiBold" Foreground="#7A7A7A" Margin="0,22,0,8"/>
                    <ItemsControl x:Name="AccountList" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="64" Margin="0,0,0,8" Cursor="Hand" Click="Account_Click"
                                        IsEnabled="{Binding Enabled}" FocusVisualStyle="{StaticResource FocusRing}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}"
                                                    BorderThickness="1" CornerRadius="12" Padding="12,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#323232"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="#333333"
                                                Margin="0,0,12,0">
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Head}" Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <Grid DockPanel.Dock="Right">
                                            <Border Style="{StaticResource Spinner}" BorderThickness="2.5"
                                                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#D36AD8" Offset="0"/>
                                                        <GradientStop Color="#D36AD8" Offset="0.3"/>
                                                        <GradientStop Color="#3A3A3A" Offset="0.31"/>
                                                        <GradientStop Color="#3A3A3A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                            </Border>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Good}"
                                                    Visibility="{Binding Ok, Converter={StaticResource BoolToVisibility}}">
                                                <c:Icon Kind="Check" Size="13" StrokeWidth="2" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Height="30" Padding="12,0" CornerRadius="8" Background="{StaticResource Accent}"
                                                    Visibility="{Binding Idle, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Anmelden" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="OtherButton" Height="56" Cursor="Hand" Click="Other_Click" FocusVisualStyle="{StaticResource FocusRing}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="#3A3A3A" BorderThickness="1.5"
                                        CornerRadius="12" Padding="12,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#303030" Margin="0,0,12,0">
                                <c:Icon Kind="Microsoft" Size="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Mit anderem Microsoft-Konto anmelden" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#D9D9D9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="BackProblem" FontSize="12.5" Foreground="{StaticResource DangerText}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                    <Button x:Name="ContinueButton" Style="{StaticResource BigButton}" Margin="0,22,0,0" Visibility="Collapsed"
                            Click="Close_Welcome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Weiter zum Launcher" VerticalAlignment="Center"/>
                            <c:Icon Kind="ArrowRight" Size="16" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="BackHint" Text="Die Anmeldung öffnet sich in einem eigenen Fenster." FontSize="12"
                               Foreground="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                    <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Ohne Anmeldung fortfahren"
                            Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Click="Close_Welcome_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,22" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
