<UserControl x:Class="AxoClient.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             xmlns:pages="clr-namespace:AxoClient.UI.Pages">
    <UserControl.Resources>
        <DataTemplate x:Key="InstanceThumb">
            <Grid>
                <Border Background="{Binding Placeholder}" CornerRadius="7">
                    <c:Icon Kind="Cube" Size="14" Foreground="#80FFFFFF" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="7">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="0,28,0,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SkinArea" Margin="0,0,0,24" SizeChanged="SkinArea_SizeChanged">
                <c:SkinViewer x:Name="SkinView" Width="320" Height="480" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <c:SkinViewer.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="18" Direction="270" Opacity="0.35"/>
                    </c:SkinViewer.Effect>
                </c:SkinViewer>
            </Grid>

            <Border x:Name="LaunchPanel" Grid.Row="1" Width="460" Padding="16" CornerRadius="14"
                    Background="{StaticResource CardBg}" HorizontalAlignment="Center">
                <StackPanel>
                    <ToggleButton x:Name="InstancePicker" Height="52" Cursor="Hand" Margin="0,0,0,12"
                                  FocusVisualStyle="{StaticResource FocusRing}" ToolTip="Instanz auswählen"
                                  Checked="InstancePicker_Checked">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="#323232" CornerRadius="10" Padding="10,0,14,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" ClipToBounds="True"
                                    Margin="0,0,12,0">
                                <ContentPresenter x:Name="CurrentThumb" ContentTemplate="{StaticResource InstanceThumb}"/>
                            </Border>
                            <c:Icon x:Name="PickerChevron" DockPanel.Dock="Right" Kind="ChevronUp" Size="16"
                                    Foreground="{StaticResource SubtleText}" RenderTransformOrigin="0.5,0.5">
                                <c:Icon.RenderTransform>
                                    <RotateTransform/>
                                </c:Icon.RenderTransform>
                            </c:Icon>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="INSTANZ" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MutedText}"/>
                                <TextBlock FontSize="14" FontWeight="Medium" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="CurrentName" Foreground="{StaticResource TextPrimary}"/>
                                    <Run x:Name="CurrentVersion" Foreground="{StaticResource MutedText}" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </ToggleButton>

                    <Button x:Name="PlayButton" Height="64" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                            Click="PlayButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Glow" CornerRadius="12" Background="{StaticResource Accent}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{StaticResource AccentGlow}" BlurRadius="24"
                                                              ShadowDepth="8" Direction="270" Opacity="0.35"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border x:Name="Base" CornerRadius="12" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"/>
                                    <Border x:Name="Hl" CornerRadius="12" Background="White" Opacity="0"/>
                                    <ContentPresenter/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hl" Property="Opacity" Value="0.08"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Hl" Property="Opacity" Value="0.14"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="flat">
                                        <Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid x:Name="PlayLayers" ClipToBounds="True">
                            <Border x:Name="PlayFill" CornerRadius="12" HorizontalAlignment="Left" Width="0"
                                    Background="{StaticResource AccentHorizontal}"/>
                            <Border x:Name="PlayShine" Width="120" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ShineMove"/>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:Icon x:Name="PlayIcon" Kind="Play" Size="18" Foreground="White" Margin="0,0,10,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlayText" Text="Spielen" FontSize="20" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlayPercent" FontSize="15" FontWeight="Bold" Foreground="#D9FFFFFF"
                                           Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Popup x:Name="InstancePopup" Grid.Row="1" PlacementTarget="{Binding ElementName=InstancePicker}"
                   Placement="Top" VerticalOffset="-8" HorizontalOffset="-12" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Fade" Closed="InstancePopup_Closed">
                <Border Margin="12,24,12,4" Padding="6" CornerRadius="12" Background="#2F2F2F" BorderBrush="#3A3A3A"
                        BorderThickness="1" Width="428" Effect="{StaticResource PopupShadow}">
                    <StackPanel>
                        <TextBlock Text="INSTANZ WÄHLEN" Style="{StaticResource OverLabel}" Margin="8,6,8,4"/>
                        <ItemsControl x:Name="InstanceList" Style="{StaticResource PlainList}" MaxHeight="360">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Item" Style="{StaticResource MenuItemButton}" Height="42" Padding="8,0"
                                            Margin="0,0,0,2" Click="InstanceItem_Click">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="7"
                                                    ClipToBounds="True" Margin="0,0,10,0">
                                                <ContentPresenter Content="{Binding}"
                                                                  ContentTemplate="{StaticResource InstanceThumb}"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="12"
                                                       Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Column="1" Margin="0,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="ServerRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <pages:FriendsPanel x:Name="Friends"/>
            <pages:QuickServersPanel x:Name="Servers" Grid.Row="1" Margin="0,16,0,0" MaxHeight="300"/>
        </Grid>
    </Grid>
</UserControl>
