<UserControl x:Class="AxoClient.UI.Pages.QuickServersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <Border Style="{StaticResource Card}" Padding="16">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        ToolTip="Server hinzufügen" Click="Add_Click">
                    <c:Icon Kind="Plus" Size="16"/>
                </Button>
                <TextBlock Text="Server" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Style="{StaticResource Caption}" FontSize="13"
                       Visibility="Collapsed"/>

            <ItemsControl x:Name="ServerList" Style="{StaticResource PlainList}" Margin="0,0,-6,0" Padding="0,0,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Margin="0,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                        Background="#3A3A3A" Margin="0,0,12,0">
                                    <Grid>
                                        <c:Icon Kind="Server" Size="20" Foreground="{StaticResource MutedText}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Border>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GoodIconButton}"
                                        ToolTip="Beitreten" Click="Join_Click">
                                    <c:Icon Kind="Play" Size="14"/>
                                </Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0"
                                            VerticalAlignment="Center" ToolTip="{Binding Status}">
                                    <c:PingBars Level="{Binding PingLevel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding PingText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding PingLevel, Converter={StaticResource PingBrush}}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource RowSub}">
                                        <Run Text="{Binding Address, Mode=OneWay}"/><Run Text="{Binding PlayersSuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
