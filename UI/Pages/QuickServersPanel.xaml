<UserControl x:Class="AxoClient.UI.Pages.QuickServersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14" Background="#991E1F22" CornerRadius="10">
        <DockPanel MaxHeight="260">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12"
                        Content="&#xE72C;" ToolTip="Aktualisieren" Click="Refresh_Click"/>
                <TextBlock x:Name="Header" Text="Server" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <ListBox x:Name="ServerList" Style="{StaticResource CardList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="4"
                                    Background="#22FFFFFF" Margin="0,0,10,0" VerticalAlignment="Top"
                                    ClipToBounds="True">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                                    Background="{StaticResource Accent}" Content="Beitreten" Padding="8,5"
                                    VerticalAlignment="Top" Margin="8,0,0,0" Click="Join_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Online}" Value="True">
                                                    <Setter Property="Foreground" Value="#6FCF97"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
