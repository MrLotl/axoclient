<UserControl x:Class="AxoClient.UI.Pages.SkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="StageBrush" Center="0.5,0.85" GradientOrigin="0.5,0.85" RadiusX="1.2" RadiusY="0.7">
            <GradientStop Color="#2F2F2F" Offset="0"/>
            <GradientStop Color="#2A2A2A" Offset="0.55"/>
            <GradientStop Color="#262626" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="ActiveBadge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>

        <DataTemplate x:Key="SkinCard">
            <Border x:Name="Card" CornerRadius="12" Padding="10" Margin="0,0,16,16" Background="{StaticResource CardBg}"
                    BorderThickness="1" BorderBrush="Transparent">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Height="230" c:Field.Corner="8" Background="#262626"
                            ToolTip="{Binding ApplyTip}" Click="ApplySkin_Click">
                        <Grid>
                            <Image Source="{Binding Preview}" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Effect="{StaticResource SoftShadow}"/>
                            <Border Style="{StaticResource ActiveBadge}"
                                    Visibility="{Binding Active, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <DockPanel Margin="2,10,2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActTrash}" Margin="6,0,0,0" ToolTip="Aus der Bibliothek entfernen"
                                Click="RemoveSkin_Click">
                            <c:Icon Kind="Trash" Size="14"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActButton}" Margin="6,0,0,0" ToolTip="Bearbeiten"
                                Click="EditSkin_Click">
                            <c:Icon Kind="Pencil" Size="14"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentFaint}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CapeCard">
            <Grid>
                <Border x:Name="Card" CornerRadius="12" Padding="10" Margin="0,0,14,14" Background="{StaticResource CardBg}"
                        BorderThickness="1" BorderBrush="Transparent">
                    <Button Style="{StaticResource RowButton}" Click="Cape_Click" ToolTip="{Binding Tip}"
                            MouseEnter="Cape_MouseEnter" MouseLeave="Cape_MouseLeave">
                        <StackPanel>
                            <Grid Height="168">
                                <Border CornerRadius="8" Background="#262626"/>
                                <Image Source="{Binding Image}" Width="80" Height="128" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Effect="{StaticResource SoftShadow}"
                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
                                <Border Width="80" Height="128" CornerRadius="6" BorderThickness="2" BorderBrush="#4A4A4A"
                                        Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibility}}">
                                    <c:Icon Kind="Ban" Size="22" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Height="22" Padding="8,0"
                                        CornerRadius="6" Background="#80000000"
                                        Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Kind="Link" Size="11" Foreground="#F2F2F2" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding LinkLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F2F2"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ActiveBadge}"
                                        Visibility="{Binding Active, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" Margin="2,10,2,0"/>
                            <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource MutedText}" Margin="2,2,2,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Button Style="{StaticResource TrashButton}" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16,16,0,0" ToolTip="Cape löschen" Click="DeleteCape_Click"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                    <c:Icon Kind="Trash" Size="12"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentFaint}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="UploadCard">
            <Button Style="{StaticResource RowButton}" MinHeight="222" Margin="0,0,14,14" c:Field.Corner="12" BorderThickness="1.5"
                    BorderBrush="#3A3A3A" Click="NewCape_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                        <c:Icon Kind="Plus" Size="20" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Eigenes Cape" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Selbst pixeln oder PNG hochladen" FontSize="11.5" Foreground="{StaticResource LabelText}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <c:FuncTemplateSelector x:Key="CapeSelector" Normal="{StaticResource CapeCard}" Special="{StaticResource UploadCard}"/>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="14" Background="{StaticResource StageBrush}" Padding="20">
            <DockPanel>
                <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" Text="AKTUELLER SKIN" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedText}"/>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Row}" Padding="12,10" CornerRadius="10" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="ActiveSkinName" FontSize="14" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Text="Skin" FontSize="12" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}" Padding="12,10" CornerRadius="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="ActiveCapeName" FontSize="14" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Text="Cape" FontSize="12" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <Grid Margin="0,12,0,12">
                    <c:SkinViewer x:Name="CurrentSkin" MaxHeight="470">
                        <c:SkinViewer.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="18" Direction="270" Opacity="0.4"/>
                        </c:SkinViewer.Effect>
                    </c:SkinViewer>
                    <TextBlock x:Name="LoginHint" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed"
                               Text="Melde dich oben rechts an, um Skins und Capes zu ändern."/>
                </Grid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <Border DockPanel.Dock="Left" Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SkinsTab" Style="{StaticResource SegmentButton}" GroupName="SkinTab" Content="Skins"
                                     FontSize="13" Padding="16,0" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="CapesTab" Style="{StaticResource SegmentButton}" GroupName="SkinTab" Content="Capes"
                                     FontSize="13" Padding="16,0" Margin="2,0,0,0" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="SkinActions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="Adopt_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Person" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Von Spieler übernehmen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0" c:Field.Corner="8" Margin="12,0,0,0"
                            Click="Upload_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Upload" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Skin hochladen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="CapeActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="AdminsButton" Style="{StaticResource ToolButton}" Click="Admins_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Shield" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Admins" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0" c:Field.Corner="8" Margin="12,0,0,0"
                            Click="NewCape_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Upload" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Eigenes Cape hochladen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource MutedText}" Margin="12,0"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <Grid>
                <ScrollViewer x:Name="SkinsView" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <StackPanel>
                        <ItemsControl x:Name="LibraryList" ItemTemplate="{StaticResource SkinCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top" Margin="0,0,-16,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="LibraryEmpty" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                                   Margin="0,40,0,0" Visibility="Collapsed"
                                   Text="Noch keine Skins gespeichert. Lade einen hoch oder übernimm ihn von einem Spieler."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CapesView" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0"
                              Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Minecraft-Capes" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Offizielle Capes deines Microsoft-Kontos · für alle sichtbar" FontSize="12"
                                       Foreground="{StaticResource LabelText}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ItemsControl x:Name="McCapes" ItemTemplate="{StaticResource CapeCard}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" VerticalAlignment="Top" Margin="0,0,-14,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="AxoClient-Capes" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Nur für andere AxoClient-Spieler sichtbar · überdeckt dein Minecraft-Cape" FontSize="12"
                                       Foreground="{StaticResource LabelText}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <ItemsControl x:Name="AxoCapes" ItemTemplateSelector="{StaticResource CapeSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" VerticalAlignment="Top" Margin="0,0,-14,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="AxoHint" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
