<UserControl x:Class="AxoClient.UI.Pages.SkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AxoClient.UI.Controls">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Skins" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <RadioButton x:Name="SkinsTab" Style="{StaticResource SegmentButton}" GroupName="SkinsTab"
                             Content="Skins" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="McCapesTab" Style="{StaticResource SegmentButton}" GroupName="SkinsTab"
                             Content="Capes (Minecraft)" Checked="Tab_Checked"/>
                <RadioButton x:Name="AxoCapesTab" Style="{StaticResource SegmentButton}" GroupName="SkinsTab"
                             Content="Capes (AxoClient)" Checked="Tab_Checked"/>
            </WrapPanel>

            <TextBlock x:Name="LoginHint" DockPanel.Dock="Top" Foreground="{StaticResource SubtleText}"
                       Text="Melde dich links unten an, um Skins und Umhänge zu ändern." Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="PreviewTitle" Text="Aktueller Skin" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10">
                        <controls:SkinViewer x:Name="CurrentSkin" Height="320"/>
                    </Border>
                    <StackPanel x:Name="CapeModePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <RadioButton x:Name="CapeModeCape" Style="{StaticResource SegmentButton}" GroupName="CapeMode"
                                     Content="Umhang" IsChecked="True" Padding="12,5" Checked="CapeMode_Checked"/>
                        <RadioButton x:Name="CapeModeElytra" Style="{StaticResource SegmentButton}" GroupName="CapeMode"
                                     Content="Elytra" Padding="12,5" Checked="CapeMode_Checked"/>
                    </StackPanel>
                    <TextBlock x:Name="CurrentVariant" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,10"/>
                    <Button x:Name="SaveCurrentButton" Style="{StaticResource LauncherButton}"
                            Content="In Bibliothek speichern" Click="SaveCurrent_Click"/>
                </StackPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                        </ScrollViewer.Resources>
                        <Grid Margin="0,0,12,0">

                            <StackPanel x:Name="SkinsView">
                                <TextBlock Text="Neuen Skin hinzufügen" Style="{StaticResource SectionTitle}"/>
                                <Border x:Name="DropZone" AllowDrop="True" Cursor="Hand" CornerRadius="10" Padding="16"
                                        Background="#0DFFFFFF" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                                        MouseLeftButtonUp="DropZone_Click" BorderBrush="#44FFFFFF" BorderThickness="1.5">
                                    <DockPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DropText" Foreground="White" FontWeight="SemiBold"
                                                       Text="Skin-Datei (PNG) hierher ziehen oder klicken"/>
                                            <TextBlock Foreground="{StaticResource MutedText}" FontSize="11"
                                                       Text="64×64 Pixel, z.B. von namemc.com oder minecraftskins.com"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <StackPanel x:Name="NewSkinOptions" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Border Background="#14FFFFFF" CornerRadius="10" Padding="10" Margin="0,0,0,12"
                                            HorizontalAlignment="Left">
                                        <controls:SkinViewer x:Name="NewSkinPreview" Width="170" Height="230"/>
                                    </Border>
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NewSkinName" Style="{StaticResource LauncherTextBox}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Modell" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="ClassicRadio" Style="{StaticResource SegmentButton}"
                                                     GroupName="SkinVariant" Content="Breite Arme (Steve)" IsChecked="True"
                                                     Checked="Variant_Checked"/>
                                        <RadioButton x:Name="SlimRadio" Style="{StaticResource SegmentButton}"
                                                     GroupName="SkinVariant" Content="Schmale Arme (Alex)"
                                                     Checked="Variant_Checked"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ApplyNewButton" Style="{StaticResource LauncherButton}"
                                                Background="{StaticResource Accent}" Content="Anwenden &amp; speichern"
                                                Margin="0,0,8,0" Click="ApplyNew_Click"/>
                                        <Button Style="{StaticResource LauncherButton}" Content="Nur speichern"
                                                Margin="0,0,8,0" Click="SaveNew_Click"/>
                                        <Button Style="{StaticResource LauncherButton}" Content="Verwerfen"
                                                Click="DiscardNew_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Meine Skins" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                                <TextBlock x:Name="LibraryEmpty" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Noch keine Skins gespeichert. Füge oben einen hinzu oder speichere deinen aktuellen Skin."/>
                                <ItemsControl x:Name="LibraryList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="140" Background="#14FFFFFF" CornerRadius="8" Padding="10"
                                                    Margin="0,0,10,10">
                                                <StackPanel>
                                                    <Image Source="{Binding Preview}" Width="48" Height="96" Margin="0,4,0,8"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding VariantText}" Foreground="{StaticResource MutedText}"
                                                               FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                Width="30" Height="30" FontSize="12" Content="&#xE74D;"
                                                                ToolTip="Aus Bibliothek entfernen" Click="RemoveSkin_Click"/>
                                                        <Button Style="{StaticResource LauncherButton}"
                                                                Background="{StaticResource Accent}" Padding="6,6"
                                                                Content="Anwenden" Click="ApplySkin_Click"
                                                                IsEnabled="{Binding DataContext.CanApply, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="McCapesView" Visibility="Collapsed">
                                <TextBlock Text="Minecraft-Umhänge" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <TextBlock Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="Die Umhänge deines Minecraft-Kontos (z.B. Migrator, Minecon, 15 Jahre). Alle Spieler sehen sie, in jedem Launcher. Fahre mit der Maus über einen Umhang, um ihn links anzuprobieren."/>
                                <TextBlock x:Name="CapesEmpty" Foreground="{StaticResource MutedText}"
                                           Text="Dein Konto besitzt keine Umhänge." Visibility="Collapsed"/>
                                <WrapPanel x:Name="CapePanel"/>
                            </StackPanel>

                            <StackPanel x:Name="AxoCapesView" Visibility="Collapsed">
                                <TextBlock Text="AxoClient-Umhänge" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ClientCapesHint" Foreground="{StaticResource MutedText}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Sehen alle, die AxoClient nutzen (Fabric-Instanzen mit unterstützter Minecraft-Version). Ein AxoClient-Umhang wird dort statt deines Minecraft-Umhangs angezeigt. Fahre mit der Maus über einen Umhang, um ihn links anzuprobieren."/>
                                <TextBlock x:Name="ClientCapesEmpty" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Die AxoClient-Umhänge konnten (noch) nicht geladen werden." Visibility="Collapsed"/>
                                <WrapPanel x:Name="ClientCapePanel"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
