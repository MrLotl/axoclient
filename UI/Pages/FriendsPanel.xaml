<UserControl x:Class="AxoClient.UI.Pages.FriendsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="{StaticResource Offline}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presence}" Value="online">
                    <Setter Property="Fill" Value="{StaticResource Good}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="ingame">
                    <Setter Property="Fill" Value="{StaticResource Ingame}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FriendRow">
            <Border Style="{StaticResource Row}" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TrashButton}" Margin="6,0,0,0"
                            ToolTip="{Binding Name, StringFormat='{}{0} als Freund entfernen'}" Click="Remove_Click">
                        <c:Icon Kind="Trash" Size="16"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GoodIconButton}" Margin="6,0,0,0"
                            ToolTip="{Binding Name, StringFormat='{}{0} nachjoinen'}" Click="Join_Click"
                            Visibility="{Binding CanJoin, Converter={StaticResource BoolToVisibility}}">
                        <c:Icon Kind="Play" Size="16"/>
                    </Button>
                    <Button x:Name="Open" Style="{StaticResource RowButton}" Click="Profile_Click"
                            ToolTip="{Binding Name, StringFormat='Profil von {0} öffnen'}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                    Background="#3A3A3A" Margin="0,0,12,0">
                                <Image Source="{Binding HeadUrl}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Name" Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Style="{StaticResource Dot}"/>
                                    <TextBlock Text="{Binding PresenceText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Open" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource AccentTextBright}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingRow">
            <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" Background="{StaticResource RowBgSoft}"
                    BorderBrush="#3A3A3A" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TrashButton}" Margin="6,0,0,0"
                            ToolTip="Anfrage zurückziehen" Click="Remove_Click">
                        <c:Icon Kind="Close" Size="14"/>
                    </Button>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                            Background="#3A3A3A" Margin="0,0,12,0" Opacity="0.45">
                        <Image Source="{Binding HeadUrl}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" Foreground="#9A9A9A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <c:Icon Kind="Clock" Size="12" Foreground="{StaticResource Warn}" Margin="0,0,6,0"/>
                            <TextBlock Text="Anfrage gesendet" FontSize="12" Foreground="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IncomingRow">
            <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" Background="{StaticResource AccentFaint}"
                    BorderBrush="{StaticResource AccentLine}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TrashButton}" Margin="6,0,0,0"
                            ToolTip="Anfrage ablehnen" Click="Remove_Click">
                        <c:Icon Kind="Close" Size="14"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GoodIconButton}" Margin="6,0,0,0"
                            ToolTip="Anfrage annehmen" Click="Accept_Click">
                        <c:Icon Kind="Check" Size="14"/>
                    </Button>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                            Background="#3A3A3A" Margin="0,0,12,0">
                        <Image Source="{Binding HeadUrl}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Möchte dich hinzufügen" FontSize="12" Foreground="{StaticResource AccentText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="16">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        ToolTip="Freund hinzufügen" Click="Add_Click">
                    <c:Icon Kind="UserAdd" Size="16"/>
                </Button>
                <TextBlock x:Name="Header" Text="Freunde" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid>
                <ItemsControl x:Name="FriendsList" Style="{StaticResource PlainList}" Margin="0,0,-6,0" Padding="0,0,6,0">
                    <ItemsControl.ItemTemplateSelector>
                        <c:FriendTemplateSelector Friend="{StaticResource FriendRow}"
                                                  Outgoing="{StaticResource OutgoingRow}"
                                                  Incoming="{StaticResource IncomingRow}"/>
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
                <TextBlock x:Name="InfoText" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                           Margin="8,24,8,0" VerticalAlignment="Top" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
