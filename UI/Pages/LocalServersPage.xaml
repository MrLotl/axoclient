<UserControl x:Class="AxoClient.UI.Pages.LocalServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LabelText}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <DataTemplate x:Key="ServerCard">
            <Border x:Name="Card" Background="{StaticResource CardBg}" CornerRadius="12" Padding="16" Margin="0,0,16,16"
                    BorderThickness="1" BorderBrush="Transparent">
                <StackPanel>
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0">
                            <Border CornerRadius="10" Background="{Binding Placeholder}">
                                <c:Icon Kind="Server" Size="20" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <Border DockPanel.Dock="Right" Height="24" Padding="10,0" CornerRadius="12" VerticalAlignment="Center"
                                Background="{Binding StatusBackground}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusDot}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Columns="4" Margin="0,14,-8,14">
                        <Button Style="{StaticResource RowButton}" Background="#232323" c:Field.Corner="8" Margin="0,0,8,0"
                                ToolTip="Adresse kopieren" Click="Copy_Click">
                            <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding AddressTitle}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Address}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="Spieler" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Players}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="{Binding RamLabel}" Style="{StaticResource StatLabel}" TextTrimming="CharacterEllipsis"/>
                                <Grid Height="5" Margin="0,7,0,0">
                                    <Border CornerRadius="3" Background="#383838"/>
                                    <Border CornerRadius="3" Background="{StaticResource AccentBright}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding RamFraction}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="Laufzeit" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button Style="{StaticResource LinkButton}" Margin="0,-4,0,12" HorizontalAlignment="Left"
                            Foreground="{Binding ReachBrush}" ToolTip="{Binding ReachTip}" Click="CopyShare_Click"
                            Visibility="{Binding HasReach, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="{Binding ReachIcon}" Size="13" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ReachText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Height="32" Padding="14,0" FontWeight="SemiBold"
                                Background="{Binding RunBackground}" Foreground="{Binding RunForeground}" IsEnabled="{Binding CanToggle}"
                                Click="Toggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="{Binding RunIcon}" Size="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding RunLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SmallGoodButton}" Height="32" Margin="6,0,0,0"
                                Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" Click="Join_Click"
                                ToolTip="Mit passender Instanz beitreten">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Join" Size="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Beitreten" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActButton}" Width="32" Height="32" ToolTip="Logs in der Live-Konsole öffnen"
                                    Click="Console_Click">
                                <c:Icon Kind="Terminal" Size="15"/>
                            </Button>
                            <Button Style="{StaticResource ActButton}" Width="32" Height="32" ToolTip="Server-Ordner öffnen"
                                    Click="Folder_Click">
                                <c:Icon Kind="Folder" Size="15"/>
                            </Button>
                            <Button Style="{StaticResource ActButton}" Width="32" Height="32" ToolTip="Einstellungen" Click="Edit_Click">
                                <c:Icon Kind="Gear" Size="15"/>
                            </Button>
                            <Button Style="{StaticResource ActTrash}" Width="32" Height="32" Margin="0" ToolTip="Server löschen"
                                    Click="Delete_Click">
                                <c:Icon Kind="Trash" Size="15"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Busy}" FontSize="12" Foreground="{StaticResource AccentText}" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#593FB950"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CreateCard">
            <Button Style="{StaticResource RowButton}" MinHeight="220" Margin="0,0,16,16" c:Field.Corner="12" BorderThickness="1.5"
                    BorderBrush="#3A3A3A" Click="Create_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                        <c:Icon Kind="Plus" Size="22" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Neuen Server aufsetzen" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Vanilla, Paper, Fabric oder Velocity · Version, Port und RAM wählst du im nächsten Schritt"
                               FontSize="12" Foreground="{StaticResource LabelText}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="280" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ServerRow">
            <Border x:Name="Card" Background="{StaticResource CardBg}" CornerRadius="12" Padding="12,10,12,10" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="Transparent">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0">
                        <Border CornerRadius="9" Background="{Binding Placeholder}">
                            <c:Icon Kind="Server" Size="18" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="9">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallGoodButton}" Height="32" Margin="0,0,6,0"
                                Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" Click="Join_Click"
                                ToolTip="Mit passender Instanz beitreten">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Join" Size="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Beitreten" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallButton}" Height="32" Padding="12,0" FontWeight="SemiBold" Margin="0,0,10,0"
                                Background="{Binding RunBackground}" Foreground="{Binding RunForeground}" IsEnabled="{Binding CanToggle}"
                                Click="Toggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="{Binding RunIcon}" Size="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding RunLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActButton}" Width="32" Height="32" ToolTip="Logs in der Live-Konsole öffnen"
                                Click="Console_Click">
                            <c:Icon Kind="Terminal" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource ActButton}" Width="32" Height="32" ToolTip="Server-Ordner öffnen" Click="Folder_Click">
                            <c:Icon Kind="Folder" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource ActButton}" Width="32" Height="32" ToolTip="Einstellungen" Click="Edit_Click">
                            <c:Icon Kind="Gear" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource ActTrash}" Width="32" Height="32" Margin="0" ToolTip="Server löschen"
                                Click="Delete_Click">
                            <c:Icon Kind="Trash" Size="15"/>
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Height="24" Padding="10,0" CornerRadius="12" VerticalAlignment="Center"
                            Margin="0,0,14,0" Background="{Binding StatusBackground}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusDot}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Width="70" Margin="0,0,10,0">
                            <TextBlock Text="Spieler" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding Players}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Width="90">
                            <TextBlock Text="Laufzeit" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource DimText}"/>
                            <Button Style="{StaticResource LinkButton}" FontSize="12" Foreground="{StaticResource MutedText}"
                                    ToolTip="Adresse kopieren" Click="Copy_Click">
                                <TextBlock>
                                    <Run Text="{Binding Address, Mode=OneWay}"/>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding Busy}" FontSize="12" Foreground="{StaticResource AccentText}" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasBusy, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <Button Style="{StaticResource LinkButton}" Margin="0,3,0,0" HorizontalAlignment="Left"
                                Foreground="{Binding ReachBrush}" ToolTip="{Binding ReachTip}" Click="CopyShare_Click"
                                Visibility="{Binding HasReach, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="{Binding ReachIcon}" Size="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ReachText}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#593FB950"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CreateRow">
            <Button Style="{StaticResource RowButton}" Height="62" Margin="0,0,0,8" c:Field.Corner="12" BorderThickness="1.5"
                    BorderBrush="#3A3A3A" Click="Create_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                        <c:Icon Kind="Plus" Size="16" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Neuen Server aufsetzen" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <c:FuncTemplateSelector x:Key="CardSelector" Normal="{StaticResource ServerCard}" Special="{StaticResource CreateCard}"/>
        <c:FuncTemplateSelector x:Key="RowSelector" Normal="{StaticResource ServerRow}" Special="{StaticResource CreateRow}"/>

        <ItemsPanelTemplate x:Key="GridPanel">
            <c:TileGrid TileWidth="540" VerticalAlignment="Top" Margin="0,0,-16,0"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lokale Server" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Pill}" Margin="12,0,0,0">
                    <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="GridToggle" Style="{StaticResource SegmentIconButton}" GroupName="ServerView"
                                     ToolTip="Kartenansicht" Checked="ViewToggle_Checked">
                            <c:Icon Kind="Grid" Size="16"/>
                        </RadioButton>
                        <RadioButton x:Name="ListToggle" Style="{StaticResource SegmentIconButton}" GroupName="ServerView"
                                     ToolTip="Listenansicht" Margin="2,0,0,0" Checked="ViewToggle_Checked">
                            <c:Icon Kind="List" Size="16"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource MutedText}" Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Width="36" Padding="0" ToolTip="Server-Ordner öffnen" Click="OpenRoot_Click">
                    <c:Icon Kind="Folder" Size="16"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="12,0,0,0" Click="Import_Click"
                        ToolTip="Einen vorhandenen Server-Ordner übernehmen">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Import" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Server importieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0" c:Field.Corner="8" Margin="12,0,0,0"
                        Click="Create_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Plus" Size="16" StrokeWidth="1.8" Margin="0,0,8,0"/>
                        <TextBlock Text="Server erstellen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <ItemsControl x:Name="ServerList" Style="{StaticResource PlainList}" Margin="0,0,-8,0" Padding="0,0,8,0"
                      ItemTemplateSelector="{StaticResource CardSelector}" ItemsPanel="{StaticResource GridPanel}"/>
    </DockPanel>
</UserControl>
