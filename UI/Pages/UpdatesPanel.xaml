<UserControl x:Class="AxoClient.UI.Pages.UpdatesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;"
                    ToolTip="Zurück zu den Instanzen" Margin="0,0,12,0" Click="Back_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RescanButton" Style="{StaticResource LauncherButton}" Content="Erneut suchen"
                        Margin="0,0,8,0" Click="Rescan_Click"/>
                <Button x:Name="UpdateAllButton" Style="{StaticResource LauncherButton}"
                        Background="{StaticResource Accent}" Content="Alle aktualisieren" Click="UpdateAll_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Updates" Style="{StaticResource PageTitle}" FontSize="20"/>
                <TextBlock x:Name="SubHeader" Foreground="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,10,12,0"/>

        <Grid>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                       VerticalAlignment="Top" Visibility="Collapsed"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="UpdateList" Margin="0,0,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" Foreground="#6FCF97" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource LauncherButton}" Content="Aktualisieren"
                                                Padding="12,6" Click="UpdateOne_Click"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Where, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding Change, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
