<UserControl x:Class="AxoClient.UI.Pages.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls"
             xmlns:pages="clr-namespace:AxoClient.UI.Pages"
             xmlns:tabs="clr-namespace:AxoClient.UI.InstanceTabs">
    <UserControl.Resources>
        <DataTemplate x:Key="Thumb">
            <Grid>
                <Border Background="{Binding Placeholder}" CornerRadius="8">
                    <c:Icon Kind="Cube" Size="22" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="8">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StartButton">
            <Button Style="{StaticResource GoodButton}" Height="36" c:Field.Corner="8" FontSize="13" Click="Play_Click"
                    ToolTip="{Binding Name, StringFormat='{}{0} starten'}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="{Binding PlayIcon}" Size="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Background="{StaticResource CardBg}" CornerRadius="12" Padding="10" Margin="0,0,16,16">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Click="Open_Click" ToolTip="{Binding Name, StringFormat='{}{0} öffnen'}">
                        <c:AspectBox>
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,2000,2000"/>
                                </Grid.Clip>
                                <Border CornerRadius="8" Background="{Binding Placeholder}"/>
                                <Border CornerRadius="8" Opacity="0.55" ClipToBounds="True">
                                    <Border Margin="-30">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="24"/>
                                        </Border.Effect>
                                    </Border>
                                </Border>
                                <Grid Margin="0,16,0,34" HorizontalAlignment="Center"
                                      Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">
                                    <Border CornerRadius="16" Background="#26FFFFFF" Effect="{StaticResource SoftShadow}">
                                        <c:Icon Kind="Cube" Size="28" Foreground="#80FFFFFF" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="16">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,4"
                                        CornerRadius="6" Background="#80000000">
                                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#F2F2F2"/>
                                </Border>
                            </Grid>
                        </c:AspectBox>
                    </Button>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="2,10,2,10"/>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StartButton}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate">
            <Border x:Name="Card" Background="{StaticResource CardBg}" CornerRadius="10" Padding="8,8,10,8" Margin="0,0,0,8">
                <DockPanel>
                    <ContentPresenter DockPanel.Dock="Right" Width="120" Content="{Binding}"
                                      ContentTemplate="{StaticResource StartButton}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource RowButton}" Click="Open_Click" Margin="0,0,14,0"
                            ToolTip="{Binding Name, StringFormat='{}{0} öffnen'}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="54" Height="54"
                                    Margin="0,0,14,0">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <c:TileGrid TileWidth="280" VerticalAlignment="Top" Margin="0,0,-16,0"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <DockPanel x:Name="ListView" Margin="28,24,28,24">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Instanzen" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Pill}" Margin="12,0,0,0">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GridToggle" Style="{StaticResource SegmentIconButton}" GroupName="InstanceView"
                                         ToolTip="Kartenansicht" Checked="ViewToggle_Checked">
                                <c:Icon Kind="Grid" Size="16"/>
                            </RadioButton>
                            <RadioButton x:Name="ListToggle" Style="{StaticResource SegmentIconButton}" GroupName="InstanceView"
                                         ToolTip="Listenansicht" Margin="2,0,0,0" Checked="ViewToggle_Checked">
                                <c:Icon Kind="List" Size="16"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolButton}" Click="Modpacks_Click"
                            ToolTip="Fertige Modpacks von Modrinth installieren">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Download" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Modpacks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" Style="{StaticResource ToolButton}" Margin="12,0,0,0" Click="Import_Click"
                            ToolTip="Instanzen aus anderen Launchern oder aus einer Datei übernehmen">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Import" Size="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Importieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0,16,0" c:Field.Corner="8"
                            Margin="12,0,0,0" Click="New_Click">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="Plus" Size="16" StrokeWidth="1.8" Margin="0,0,8,0"/>
                            <TextBlock Text="Neue Instanz" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid>
                <ItemsControl x:Name="InstanceList" Style="{StaticResource PlainList}" Margin="0,0,-8,0" Padding="0,0,8,0"/>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                        <c:Icon Kind="Library" Size="28" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Noch keine Instanzen" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,6"/>
                    <TextBlock Text="Lege eine neue Instanz an oder installiere ein Modpack." Style="{StaticResource Caption}"
                               FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <DockPanel x:Name="DetailView" Margin="28,24,28,24" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Height="200" CornerRadius="14" Background="{StaticResource DeepBg}" ClipToBounds="True"
                    Margin="0,0,0,16">
                <Grid x:Name="Hero">
                    <Border x:Name="HeroArt" CornerRadius="14"/>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F0181818" Offset="0"/>
                                <GradientStop Color="#B8181818" Offset="0.45"/>
                                <GradientStop Color="#59181818" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <DockPanel Margin="16,16,20,20">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource ButtonBase}" Height="30"
                                Padding="8,0,12,0" Background="#59000000" Foreground="{StaticResource TextPrimary}"
                                FontSize="13" FontWeight="Medium" Click="Back_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="ChevronLeft" Size="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Zurück" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <DockPanel VerticalAlignment="Bottom">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource HeroButton}" ToolTip="Instanz an Freunde senden" Click="Share_Click">
                                    <c:Icon Kind="Share" Size="18"/>
                                </Button>
                                <Button Style="{StaticResource HeroButton}" Margin="10,0,0,0" ToolTip="Instanzordner öffnen"
                                        Click="Folder_Click">
                                    <c:Icon Kind="Folder" Size="18"/>
                                </Button>
                                <Button x:Name="HeroPlay" Style="{StaticResource GoodButton}" Height="44" Padding="20,0,24,0"
                                        c:Field.Corner="10" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" Click="DetailPlay_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon x:Name="HeroPlayIcon" Kind="Play" Size="16" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="HeroPlayText" Text="Spielen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="Bold" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel x:Name="HeroChips" Orientation="Horizontal" Margin="0,8,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerSoft}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                <StackPanel x:Name="DetailTabs" Orientation="Horizontal" Height="38">
                    <RadioButton x:Name="OverviewTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Übersicht" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="ModsTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Mods" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="PacksTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Ressourcepacks" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="ShadersTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Shader" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="WorldsTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Welten" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="ServersTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Server" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="ScreenshotsTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Screenshots" Checked="DetailTab_Checked"/>
                    <RadioButton x:Name="SettingsTab" Style="{StaticResource TabButton}" GroupName="InstanceTab"
                                 Content="Einstellungen" Checked="DetailTab_Checked"/>
                </StackPanel>
            </Border>

            <Grid>
                <tabs:InstanceOverview x:Name="OverviewView"/>
                <tabs:ContentPanel x:Name="ContentView" Visibility="Collapsed"/>
                <tabs:WorldsPanel x:Name="WorldsView" Visibility="Collapsed"/>
                <tabs:ServersPanel x:Name="ServersView" Visibility="Collapsed"/>
                <tabs:ScreenshotsPanel x:Name="ScreenshotsView" Visibility="Collapsed"/>
                <tabs:InstanceEditor x:Name="Editor" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>

        <tabs:InstanceEditor x:Name="Creator" Margin="28,24,28,24" Visibility="Collapsed"/>

        <pages:ModpackPanel x:Name="ModpackView" Margin="28,24,28,24" Visibility="Collapsed"/>
    </Grid>
</UserControl>
