<UserControl x:Class="AxoClient.UI.Pages.GameLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Background" Value="#333333"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="Copy_Click" ToolTip="Markierte Zeilen kopieren, sonst alle angezeigten">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Copy" Size="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CopyText" Text="Kopieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Eraser" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Leeren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Folder" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Logs-Ordner öffnen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Live-Konsole" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <ToggleButton x:Name="SourceButton" Height="30" Margin="12,0,0,0" Cursor="Hand" Checked="SourceButton_Checked"
                              FocusVisualStyle="{StaticResource FocusRing}" ToolTip="Log-Quelle wählen">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{StaticResource CardBg}" CornerRadius="15" Padding="10,0,8,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#323232"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SourceDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SourceStatus" FontSize="12" FontWeight="Medium" Foreground="{StaticResource SubtleText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center">
                            <Run x:Name="SourceKind"/><Run Text=" · "/><Run x:Name="SourceName" Foreground="{StaticResource TextPrimary}" FontWeight="Medium"/><Run x:Name="SourceType"/>
                        </TextBlock>
                        <c:Icon Kind="ChevronDown" Size="14" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <Popup x:Name="SourcePopup" PlacementTarget="{Binding ElementName=SourceButton}" Placement="Bottom" VerticalOffset="4"
                   HorizontalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" Closed="SourcePopup_Closed">
                <Border Margin="12,4,16,28" Width="340" Padding="6" CornerRadius="12" Background="{StaticResource PopupBg}"
                        BorderBrush="{StaticResource PopupLine}" BorderThickness="1" Effect="{StaticResource PopupShadow}">
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SourceList"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBox x:Name="FilterBox" DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="320"
                     c:Field.Hint="Logs durchsuchen…" TextChanged="FilterBox_TextChanged"/>
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentGroup}" Background="{StaticResource CardBg}" Margin="12,0,0,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LevelAll" Style="{StaticResource SegmentButton}" GroupName="LogLevel" IsChecked="True"
                                 Checked="Level_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alle" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource CountBadge}">
                                <TextBlock x:Name="CountAll" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LevelWarn" Style="{StaticResource SegmentButton}" GroupName="LogLevel" Margin="2,0,0,0"
                                 Checked="Level_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Warn}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Warnungen" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource CountBadge}">
                                <TextBlock x:Name="CountWarn" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LevelError" Style="{StaticResource SegmentButton}" GroupName="LogLevel" Margin="2,0,0,0"
                                 Checked="Level_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource DangerText}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fehler" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource CountBadge}">
                                <TextBlock x:Name="CountError" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Right" Background="{StaticResource CardBg}" CornerRadius="8" Padding="14,0,12,0" Height="36">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mitlaufen" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="FollowCheck" Style="{StaticResource MiniSwitch}" IsChecked="True" Click="Follow_Click"/>
                </StackPanel>
            </Border>
            <Grid/>
        </DockPanel>

        <Border CornerRadius="12" Background="#191919" BorderBrush="{StaticResource CardBg}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Height="32" BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="14,0">
                    <DockPanel>
                        <TextBlock x:Name="FollowLabel" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource DimText}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShownText" FontSize="12" Foreground="{StaticResource DimText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PathText" FontSize="12" Foreground="{StaticResource DimText}" VerticalAlignment="Center"
                                   Margin="16,0,16,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <Border x:Name="CommandBar" DockPanel.Dock="Bottom" BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="10,8"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" Margin="8,0,0,0" Click="SendCommand_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Send" Size="13" Margin="0,0,7,0"/>
                                <TextBlock Text="Senden" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="CommandBox" Style="{StaticResource LauncherTextBox}" Height="32" c:Field.Corner="8"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" c:Field.Icon="Terminal"
                                 c:Field.Hint="Befehl an den Server senden, z. B. op Spielername" KeyDown="CommandBox_KeyDown"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                             Padding="0,10" ScrollViewer.ScrollChanged="LogList_ScrollChanged" KeyDown="LogList_KeyDown"
                             PreviewMouseDown="LogList_PreviewMouseDown" PreviewMouseMove="LogList_PreviewMouseMove"
                             PreviewMouseUp="LogList_PreviewMouseUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{Binding RowBrush}" BorderBrush="{Binding MarkBrush}"
                                                    BorderThickness="2,0,0,0" Padding="14,1,16,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#33D946EF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="146"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Foreground="#5F5F5F"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="Bold" Foreground="{Binding LevelBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Thread}" Foreground="{StaticResource LabelText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{Binding MessageBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="20,40,20,0" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
