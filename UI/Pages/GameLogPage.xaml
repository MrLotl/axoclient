<UserControl x:Class="AxoClient.UI.Pages.GameLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Game Log" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ComboBox x:Name="InstanceBox" DockPanel.Dock="Left" Style="{StaticResource LauncherCombo}" Width="240"
                          SelectionChanged="InstanceBox_SelectionChanged"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Margin="8,0,0,0"
                            ToolTip="Kopieren (markierte Zeilen, sonst alle angezeigten)" Click="Copy_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE894;" Margin="8,0,0,0"
                            ToolTip="Leeren (danach erscheinen nur neue Zeilen; die Datei bleibt erhalten)"
                            Click="Clear_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0"
                            ToolTip="Ordner mit den Logs öffnen" Click="OpenFolder_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0"
                            ToolTip="Neu laden" Click="Reload_Click"/>
                </StackPanel>
                <Grid Margin="8,0,0,0">
                    <TextBox x:Name="FilterBox" Style="{StaticResource LauncherTextBox}"
                             TextChanged="FilterBox_TextChanged"/>
                    <TextBlock Text="Suchen..." Foreground="{StaticResource MutedText}" Margin="11,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <CheckBox x:Name="FollowCheck" DockPanel.Dock="Right" Content="Mitlaufen" IsChecked="True"
                          VerticalAlignment="Center" Click="Follow_Click"
                          ToolTip="Immer die neuesten Zeilen zeigen. Nach oben scrollen hält an, ganz nach unten scrollen läuft wieder mit."/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LevelAll" Style="{StaticResource SegmentButton}" GroupName="LogLevel"
                                 Content="Alles" IsChecked="True" Padding="12,5" Checked="Level_Checked"/>
                    <RadioButton x:Name="LevelWarn" Style="{StaticResource SegmentButton}" GroupName="LogLevel"
                                 Content="Warnungen &amp; Fehler" Padding="12,5" Checked="Level_Checked"/>
                    <RadioButton x:Name="LevelError" Style="{StaticResource SegmentButton}" GroupName="LogLevel"
                                 Content="Nur Fehler" Padding="12,5" Checked="Level_Checked"/>
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0"
                           Text="Markieren: ziehen, Umschalt- oder Strg-Klick, Strg+A  ·  Kopieren: Strg+C"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedText}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Border Background="#99000000" CornerRadius="8" Padding="8,6,2,6">
                <Grid>
                    <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="LogList_ScrollChanged" KeyDown="LogList_KeyDown"
                             PreviewMouseLeftButtonDown="LogList_PreviewMouseDown"
                             PreviewMouseMove="LogList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="LogList_PreviewMouseUp">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="4,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#553BA55C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               MaxWidth="420" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
