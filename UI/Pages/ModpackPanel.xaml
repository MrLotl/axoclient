<UserControl x:Class="AxoClient.UI.Pages.ModpackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="PackCard">
            <Border x:Name="Card" Background="{StaticResource CardBg}" CornerRadius="12" Padding="12,12,16,12" Margin="0,0,0,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="176" Height="99" Margin="0,0,16,0">
                        <Border CornerRadius="9" Background="{Binding Placeholder}"/>
                        <Border CornerRadius="9">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel HorizontalAlignment="Right" Visibility="{Binding Idle, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0,16,0" c:Field.Corner="9,0,0,9"
                                        Click="Install_Click" ToolTip="{Binding InstallTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Kind="Download" Size="15" Margin="0,0,8,0"/>
                                        <TextBlock Text="Installieren" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Width="36" Height="38" Padding="0" c:Field.Corner="0,9,9,0"
                                        BorderBrush="#38FFFFFF" BorderThickness="1,0,0,0" ToolTip="Version wählen"
                                        Click="Versions_Click">
                                    <c:Icon Kind="ChevronDown" Size="15"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding LatestLabel}" FontSize="11.5" Foreground="{StaticResource LabelText}"
                                       HorizontalAlignment="Right" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentText}"/>
                                <TextBlock Text="{Binding Stage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"/>
                            <TextBlock Text="{Binding BusyVersion}" FontSize="11.5" Foreground="{StaticResource LabelText}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Visibility="{Binding Done, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource GoodButton}" Height="38" Padding="16,0" c:Field.Corner="9" Click="OpenInstalled_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="Check" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Installiert · Öffnen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DoneVersion}" FontSize="11.5" Foreground="{StaticResource LabelText}"
                                       HorizontalAlignment="Right" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Project.Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            <TextBlock Text="{Binding Project.Author, StringFormat='von {0}'}" FontSize="12"
                                       Foreground="{StaticResource LabelText}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Project.Description}" FontSize="13" Foreground="#BDBDBD" TextWrapping="Wrap"
                                   MaxHeight="38" TextTrimming="CharacterEllipsis" LineHeight="19" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <c:Icon Kind="Download" Size="12" Foreground="{StaticResource LabelText}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Project.DownloadsText}" FontSize="11.5" Foreground="{StaticResource LabelText}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Tag}" Background="#303030" Margin="12,0,0,0"
                                    Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Project.Tags}" FontSize="11.5" FontWeight="SemiBold" Foreground="#BDBDBD"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Style="{StaticResource LinkButton}" FontSize="11.5" Margin="12,0,0,0" Content="Auf Modrinth"
                                    Foreground="{StaticResource LabelText}" Click="Website_Click"/>
                            <Button Style="{StaticResource LinkButton}" FontSize="11.5" Margin="12,0,0,0" Content="Senden"
                                    Foreground="{StaticResource LabelText}" Click="Share_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#2D2D2D"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="34" Height="34" Background="{StaticResource CardBg}"
                    Foreground="#BDBDBD" ToolTip="Zurück zu den Instanzen" Click="Back_Click" Margin="0,0,12,0">
                <c:Icon Kind="ChevronLeft" Size="16"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OpenFile_Click">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Kind="Folder" Size="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Aus Datei (.mrpack)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Modpacks" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Fertige Sammlungen – jedes Modpack wird als eigene Instanz installiert" FontSize="12.5"
                           Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="420"
                     c:Field.Hint="Modpacks durchsuchen …" TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="LoaderBox" DockPanel.Dock="Left" Style="{StaticResource LauncherCombo}" Height="36" Width="150"
                      Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="VersionBox" DockPanel.Dock="Left" Style="{StaticResource LauncherCombo}" Height="36" Width="150"
                      Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Style="{StaticResource LauncherCombo}" Height="36" Width="190"
                      SelectionChanged="Filter_Changed"/>
            <TextBlock DockPanel.Dock="Right" Text="Sortieren:" FontSize="12.5" Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Grid/>
        </DockPanel>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <StackPanel>
                    <ItemsControl x:Name="PackList" ItemTemplate="{StaticResource PackCard}"/>
                    <Button x:Name="MoreButton" Style="{StaticResource SmallButton}" Content="Mehr laden" HorizontalAlignment="Center"
                            Margin="0,4,0,12" Visibility="Collapsed" Click="More_Click"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,40,0,0" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
