<UserControl x:Class="AxoClient.UI.Pages.ModpackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;"
                    ToolTip="Zurück zu den Instanzen" Margin="0,0,12,0" Click="Back_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource LauncherButton}" Content="Datei öffnen..."
                    ToolTip="Ein bereits heruntergeladenes Modpack (.mrpack) installieren" Click="OpenFile_Click"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Modpacks" Style="{StaticResource PageTitle}" FontSize="20"/>
                <TextBlock Text="Von Modrinth: ein Klick, und AxoClient legt eine fertige Instanz an."
                           Foreground="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Suchen"
                    Click="Search_Click"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource LauncherTextBox}" KeyDown="SearchBox_KeyDown"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource SubtleText}"
                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>

        <TextBlock x:Name="ResultsEmpty" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel x:Name="Pager" DockPanel.Dock="Bottom" Margin="0,10,8,0" Visibility="Collapsed">
            <Button x:Name="PrevPage" DockPanel.Dock="Left" Style="{StaticResource LauncherButton}"
                    Click="PrevPage_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Zurück"/>
                </StackPanel>
            </Button>
            <Button x:Name="NextPage" DockPanel.Dock="Right" Style="{StaticResource LauncherButton}"
                    Click="NextPage_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Weiter"/>
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="PageText" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalText" Foreground="{StaticResource MutedText}" FontSize="11"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="ResultsList" Style="{StaticResource CardList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="8"
                                Background="#22FFFFFF" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Width="130">
                            <Button Style="{StaticResource LauncherButton}" Background="{StaticResource Accent}"
                                    Content="Installieren" Height="32" Padding="8,0" Click="Install_Click"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="28"
                                        FontSize="11" Margin="4,0,0,0" Content="&#xE72D;"
                                        ToolTip="Einem Freund empfehlen" Click="Share_Click"/>
                                <Button Style="{StaticResource LauncherButton}" Content="Webseite" Padding="8,4"
                                        FontSize="11" Click="Website_Click"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="White" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                <Run Text="{Binding Author, Mode=OneWay, StringFormat=von {0}}"
                                     Foreground="{StaticResource MutedText}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleText}"
                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,4"/>
                            <TextBlock Foreground="{StaticResource MutedText}" FontSize="11">
                                <Run Text="{Binding DownloadsText, Mode=OneWay}"/>
                                <Run Text="{Binding TagsSuffix, Mode=OneWay}" Foreground="#6FCF97"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
