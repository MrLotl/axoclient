<UserControl x:Class="AxoClient.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AxoClient.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="18,16,18,6"/>
        </Style>
        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="OptionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OptionRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="18,14,18,14"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="18,0"/>
            <Setter Property="Background" Value="#333333"/>
        </Style>
        <Style x:Key="SizeField" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SizeBox" TargetType="TextBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextStrong}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="4"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#A3A3A3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#353535" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <c:Icon Kind="Check" Size="14" Foreground="{StaticResource MutedText}" Margin="0,0,7,0"/>
                <TextBlock Text="Änderungen werden automatisch gespeichert" FontSize="12.5" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Gilt für den ganzen Launcher und alle Instanzen" FontSize="13" Foreground="{StaticResource MutedText}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Launcher" Style="{StaticResource SectionHead}"/>
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="AutostartCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      Margin="20,0,0,0" Click="Autostart_Click"/>
                            <StackPanel>
                                <TextBlock Text="Mit Windows starten" Style="{StaticResource OptionTitle}"/>
                                <TextBlock x:Name="AutostartHint" Style="{StaticResource OptionHint}"
                                           Text="AxoClient öffnet sich automatisch, wenn du dich bei Windows anmeldest"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource OptionRow}" Margin="18,14,18,16">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" Background="#1F1F1F" Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AfterKeepOpen" Style="{StaticResource SegmentButton}" GroupName="AfterLaunch"
                                                 Content="Offen lassen" Tag="KeepOpen" Checked="AfterLaunch_Checked"/>
                                    <RadioButton x:Name="AfterMinimize" Style="{StaticResource SegmentButton}" GroupName="AfterLaunch"
                                                 Content="Minimieren" Tag="Minimize" Margin="2,0,0,0" Checked="AfterLaunch_Checked"/>
                                    <RadioButton x:Name="AfterHide" Style="{StaticResource SegmentButton}" GroupName="AfterLaunch"
                                                 Content="Ausblenden" Tag="Hide" Margin="2,0,0,0" Checked="AfterLaunch_Checked"/>
                                    <RadioButton x:Name="AfterClose" Style="{StaticResource SegmentButton}" GroupName="AfterLaunch"
                                                 Content="Schließen" Tag="Close" Margin="2,0,0,0" Checked="AfterLaunch_Checked"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nach dem Spielstart" Style="{StaticResource OptionTitle}"/>
                                <TextBlock x:Name="AfterLaunchHint" Style="{StaticResource OptionHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Spiel" Style="{StaticResource SectionHead}"/>
                        <DockPanel Style="{StaticResource OptionRow}" Margin="18,14,18,0">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" Background="#1F1F1F" Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeWindow" Style="{StaticResource SegmentButton}" GroupName="WindowMode"
                                                 Content="Fenster" Checked="WindowMode_Checked"/>
                                    <RadioButton x:Name="ModeMaximized" Style="{StaticResource SegmentButton}" GroupName="WindowMode"
                                                 Content="Maximiert" Margin="2,0,0,0" Checked="WindowMode_Checked"/>
                                    <RadioButton x:Name="ModeFullscreen" Style="{StaticResource SegmentButton}" GroupName="WindowMode"
                                                 Content="Vollbild" Margin="2,0,0,0" Checked="WindowMode_Checked"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Fenstermodus" Style="{StaticResource OptionTitle}"/>
                                <TextBlock Text="Wie Minecraft beim Start geöffnet wird" Style="{StaticResource OptionHint}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="SizeRow" Margin="18,14,18,14" Padding="14,12" CornerRadius="10" Background="#262626">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
                                    <Border Style="{StaticResource SizeField}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimText}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="WidthBox" Style="{StaticResource SizeBox}" ToolTip="Fensterbreite in Pixeln"
                                                     PreviewTextInput="Number_PreviewTextInput" TextChanged="Size_TextChanged"
                                                     LostFocus="Size_LostFocus"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="×" FontSize="13" Foreground="{StaticResource DimText}" VerticalAlignment="Center"
                                               Margin="8,0"/>
                                    <Border Style="{StaticResource SizeField}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="H" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimText}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="HeightBox" Style="{StaticResource SizeBox}" ToolTip="Fensterhöhe in Pixeln"
                                                     PreviewTextInput="Number_PreviewTextInput" TextChanged="Size_TextChanged"
                                                     LostFocus="Size_LostFocus"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="px" FontSize="12" Foreground="{StaticResource DimText}" VerticalAlignment="Center"
                                               Margin="10,0,4,0"/>
                                    <RadioButton x:Name="Preset720" Style="{StaticResource PresetButton}" GroupName="SizePreset"
                                                 Content="720p" Tag="1280x720" Click="Preset_Click"/>
                                    <RadioButton x:Name="Preset900" Style="{StaticResource PresetButton}" GroupName="SizePreset"
                                                 Content="900p" Tag="1600x900" Click="Preset_Click"/>
                                    <RadioButton x:Name="Preset1080" Style="{StaticResource PresetButton}" GroupName="SizePreset"
                                                 Content="1080p" Tag="1920x1080" Click="Preset_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Fenstergröße" FontSize="13" FontWeight="Medium" Foreground="#D9D9D9"/>
                                    <TextBlock x:Name="SizeHint" Style="{StaticResource OptionHint}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource OptionRow}" Margin="18,14,18,16">
                            <CheckBox x:Name="PreLaunchCheckBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      Margin="20,0,0,0" Click="Check_Click"/>
                            <StackPanel>
                                <TextBlock Text="Mods bei jedem Start prüfen" Style="{StaticResource OptionTitle}"/>
                                <TextBlock Style="{StaticResource OptionHint}"
                                           Text="Prüft alle Mods und ihre Abhängigkeiten, bevor das Spiel startet. Der Start dauert etwas länger."/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Integrationen" Style="{StaticResource SectionHead}"/>
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="DiscordCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      Margin="20,0,0,0" Click="Check_Click"/>
                            <StackPanel>
                                <TextBlock Text="In Discord anzeigen" Style="{StaticResource OptionTitle}"/>
                                <TextBlock Style="{StaticResource OptionHint}"
                                           Text="Zeigt in deinem Discord-Profil „Spielt AxoClient“ mit Instanz und Server"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="RelayCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      Margin="20,0,0,0" Click="Check_Click"/>
                            <StackPanel>
                                <TextBlock Text="Freunde in Einzelspieler-Welten nachjoinen lassen" Style="{StaticResource OptionTitle}"/>
                                <TextBlock Style="{StaticResource OptionHint}" TextWrapping="Wrap"
                                           Text="Installiert e4mc in Fabric-Instanzen. Öffnest du eine Welt „für LAN“, bekommt sie eine öffentliche Adresse und Freunde können über „Nachjoinen“ beitreten."/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource RowLine}"/>
                        <DockPanel Style="{StaticResource OptionRow}" Margin="18,14,18,16">
                            <CheckBox x:Name="BadgeCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      Margin="20,0,0,0" Click="Badge_Click"/>
                            <Border DockPanel.Dock="Right" Width="190" Padding="8,6" CornerRadius="6" Background="#73000000"
                                    BorderBrush="#333333" BorderThickness="1" Margin="20,0,0,0" VerticalAlignment="Center"
                                    TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="11.5"
                                    TextElement.Foreground="{StaticResource TextStrong}">
                                <StackPanel>
                                    <Border Background="#0FFFFFFF" Padding="4,2">
                                        <DockPanel>
                                            <Image x:Name="PreviewHead" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,4,0"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <Image x:Name="PreviewBadge" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0"
                                                   Source="{StaticResource LogoGills}"/>
                                            <TextBlock x:Name="PreviewName" Text="Du" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Background="#0FFFFFFF" Padding="4,2" Margin="0,3,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0" Background="#6B8E4E"/>
                                            <TextBlock Text="Steve" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AxoClient-Symbol in der Tabliste" Style="{StaticResource OptionTitle}"/>
                                <TextBlock Style="{StaticResource OptionHint}"
                                           Text="Andere AxoClient-Spieler sehen das Symbol neben deinem Namen"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
