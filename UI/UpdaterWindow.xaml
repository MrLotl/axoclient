<Window x:Class="AxoClient.UI.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AxoClient.UI.Controls"
        Title="AxoClient Updater" Icon="/Assets/axoclient.ico" Width="520" Height="320" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimary}" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="Window_Loaded">
    <Border CornerRadius="14" Background="{StaticResource WindowBg}" BorderBrush="#2E2E2E" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,518,318" RadiusX="13" RadiusY="13"/>
            </Grid.Clip>
            <Ellipse Width="420" Height="320" Margin="-80,-140,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#38EC4899" Offset="0"/>
                        <GradientStop Color="#1A8B5CF6" Offset="0.6"/>
                        <GradientStop Color="#001F1F1F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="380" Height="300" Margin="0,0,-120,-160" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#298B5CF6" Offset="0"/>
                        <GradientStop Color="#001F1F1F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <DockPanel Margin="16,10,10,0" Height="26" VerticalAlignment="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource WindowCloseButton}" ToolTip="Schließen"
                        Click="Close_Click">
                    <c:Icon Kind="WinClose" Size="26"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource WindowButton}" ToolTip="Minimieren" Margin="0,0,4,0"
                        Click="Minimize_Click">
                    <c:Icon Kind="WinMin" Size="26"/>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="15">
                    <Run Text="Axo" FontWeight="SemiBold" Foreground="#4A4A4A"/><Run Text="Client" FontWeight="Medium" Foreground="#444444"/>
                    <Run Text=" Updater" FontSize="11" FontWeight="Medium" Foreground="#444444"/>
                </TextBlock>
            </DockPanel>

            <DockPanel Margin="32,58,32,26">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Source="{StaticResource LogoGills}" Width="64" Height="64">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="Float"/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Float" Storyboard.TargetProperty="Y"
                                                         From="0" To="-4" Duration="0:0:1.5">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="AxoClient wird aktualisiert" FontSize="19" FontWeight="Bold"
                                   Foreground="#F5F5F5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border CornerRadius="6" Background="#2C2C2C" Height="20" Padding="7,0">
                                <TextBlock x:Name="FromVersion" FontSize="12" FontWeight="SemiBold" Foreground="#9A9A9A"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <c:Icon Kind="ArrowRight" Size="14" Foreground="{StaticResource MutedText}" Margin="7,0"
                                    VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Background="{StaticResource Accent}" Height="20" Padding="7,0">
                                <TextBlock x:Name="ToVersion" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom">
                    <StackPanel x:Name="Steps" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Style="{StaticResource TextButton}" Height="32" FontSize="12.5"
                                Content="Abbrechen" Click="Cancel_Click"/>
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                Content="AxoClient starten" Visibility="Collapsed" Click="Start_Click"/>
                        <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"
                                Content="Erneut versuchen" Visibility="Collapsed" Click="Retry_Click"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="0,20,0,0">
                    <Grid Height="8">
                        <Border CornerRadius="4" Background="#2C2C2C"/>
                        <Border x:Name="Fill" CornerRadius="4" Background="{StaticResource AccentHorizontal}"
                                HorizontalAlignment="Left" Width="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#D946EF" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <DockPanel Margin="0,9,0,0">
                        <TextBlock x:Name="DetailText" DockPanel.Dock="Right" FontSize="12.5"
                                   Foreground="{StaticResource MutedText}"/>
                        <TextBlock x:Name="StatusText" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
