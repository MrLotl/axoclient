<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Ordner und Projekte heißen ohne Präfix (z. B. "Game"), Namespaces und DLLs mit ("AxoClient.Game") -->
    <RootNamespace>AxoClient.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>AxoClient.$(MSBuildProjectName)</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0-dev</Version>
    <Product>AxoClient</Product>
    <Company>AxoClient</Company>
    <!-- .Result und .Wait() sind verboten (Grundregel "Alles asynchron") -->
    <WarningsAsErrors>$(WarningsAsErrors);VSTHRD002;VSTHRD103;CS4014</WarningsAsErrors>
    <!-- Stilregeln aus .editorconfig (Klammern, Namen, Namespaces) gelten auch beim Bauen -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Die Tests dürfen interne Hilfsmethoden aller Projekte prüfen -->
    <InternalsVisibleTo Include="AxoClient.Tests" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" PrivateAssets="all" />
  </ItemGroup>
</Project>
