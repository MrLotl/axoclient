<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AxoClient</AssemblyName>
    <RootNamespace>AxoClient</RootNamespace>
    <Product>AxoClient</Product>
    <AssemblyTitle>AxoClient</AssemblyTitle>
    <ApplicationIcon>Assets\axoclient.ico</ApplicationIcon>
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\background.jpg" />
    <Resource Include="Assets\axolotl.png" />
    <Resource Include="Assets\axoclient.ico" />
    <EmbeddedResource Include="Assets\mods\mclauncher-badge-*.jar" LogicalName="badge-mods/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="mod\**;service\**;discord\**" />
    <None Remove="mod\**;service\**;discord\**" />
    <EmbeddedResource Remove="mod\**;service\**;discord\**" />
    <Page Remove="mod\**;service\**;discord\**" />
  </ItemGroup>

</Project>
